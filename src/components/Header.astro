---
import MenuIconClose from "@src/assets/menu-close.svg";
import MenuIconOpen from "@src/assets/menu-open.svg";
import Link from "astro-typesafe-routes/link";

const menuIconHeight = "1.2rem";
---

<div id="site-header">
  <!-- Structure `header`,`nav`, and `button` according to: -->
  <!-- https://dev.to/masakudamatsu/don-t-nest-nav-inside-header-do-nest-the-hamburger-menu-button-inside-nav-6cp -->
  <header></header>
  <nav id="nav-container" class="ui">
    <button
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-pages"
      aria-label="Toggle navigation menu"
      type="button"
    >
      <MenuIconOpen id="icon-open" width={menuIconHeight} />
      <MenuIconClose id="icon-close" width={menuIconHeight} />
    </button>
    <ul id="nav-pages">
      <li><Link to="/">home</Link></li>
      <li><Link to="/articles">articles</Link></li>
      <li><Link to="/tags">tags</Link></li>
    </ul>
  </nav>
</div>

<style>
  #site-header {
    top: 0;
    left: 0;
    z-index: 1000;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    width: 100%;
    padding: 0 var(--space-s-m);
  }

  #nav-container {
    padding: 0;
    margin: 0;

    #nav-toggle {
      display: none;
      width: 100%;
      padding: var(--space-s) var(--space-s) 0 0;
      color: inherit;
      cursor: pointer;
      background: none;
      border: none;
    }

    #nav-pages {
      display: flex;
      gap: var(--space-2xs-xs);
      letter-spacing: 0.05em;
      list-style: none;
    }
  }

  @media (max-width: 768px) {
    #nav-container {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 9999;
      display: block;

      #nav-toggle {
        display: grid;
        justify-content: end;

        #icon-open,
        #icon-close {
          grid-area: 1 / 1;
          transition:
            opacity 0.2s ease,
            transform 0.2s ease;
        }

        #icon-open {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }

        #icon-close {
          opacity: 0;
          transform: scale(0.5) rotate(-90deg);
        }
      }

      #nav-pages {
        display: none;
        flex-direction: column;
        width: 60%;
        padding: 1.5em 0 0 0;
        margin: auto;
        font-size: var(--font-step-2);
      }
    }

    #nav-container:has(#nav-toggle[aria-expanded="true"]) {
      position: fixed;
      width: 40vw;
      height: 100vh;
      background-color: oklch(from var(--color-bg-elevated) l c h / 80%);
      @supports (backdrop-filter: blur(4px)) {
        backdrop-filter: blur(4px);
      }

      #nav-toggle {
        #icon-open {
          opacity: 0;
          transform: scale(0.5) rotate(90deg);
        }

        #icon-close {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }
      }

      #nav-pages {
        display: flex;
      }
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    #nav-panel {
      transition: none;
    }
  
    #icon-open, #icon-close {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const navPages = document.getElementById("nav-pages");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));

    if (!isOpen) {
      navPages?.querySelector("a")?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) {
      return;
    }

    if (!(toggle?.contains(e.target) || navPages?.contains(e.target))) {
      toggle?.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>

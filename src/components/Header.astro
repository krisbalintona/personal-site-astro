---
import MenuIconClose from "@src/assets/menu-close.svg";
import MenuIconOpen from "@src/assets/menu-open.svg";
import Link from "astro-typesafe-routes/link";

const menuIconHeight = "1.2rem";
---

<div id="site-header">
  <!-- Structure `header`,`nav`, and `button` according to: -->
  <!-- https://dev.to/masakudamatsu/don-t-nest-nav-inside-header-do-nest-the-hamburger-menu-button-inside-nav-6cp -->
  <header></header>
  <nav id="nav-container" class="ui">
    <button
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-pages"
      aria-label="Toggle navigation menu"
      type="button"
    >
      <MenuIconOpen aria-hidden="true" id="icon-open" width={menuIconHeight} />
      <MenuIconClose
        aria-hidden="true"
        id="icon-close"
        width={menuIconHeight}
      />
    </button>
    <div id="nav-panel">
      <ul id="nav-pages">
        <li><Link to="/">home</Link></li>
        <li><Link to="/articles">articles</Link></li>
        <li><Link to="/tags">tags</Link></li>
      </ul>
    </div>
  </nav>
</div>

<style>
  #site-header {
    position: block;
    top: 0;
    left: 0;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    width: 100%;
    padding: 0 var(--space-s-m);
  }

  #nav-container {
    padding: 0;
    margin: 0;

    #nav-toggle {
      display: none;
      width: 100%;
      padding: var(--space-s) var(--space-s) 0 0;
      color: inherit;
      cursor: pointer;
      background: none;
      border: none;
    }

    #nav-pages {
      display: flex;
      gap: var(--space-2xs-xs);
      letter-spacing: 0.05em;
      list-style: none;
    }
  }

  @media (max-width: 768px) {
    #nav-container {
      position: absolute;
      top: 0;
      right: 0;
      display: block;

      #nav-toggle {
        --_transition-duration: 0.2s;

        display: grid;
        justify-content: end;

        #icon-open,
        #icon-close {
          grid-area: 1 / 1;
          transition:
            opacity var(--_transition-duration) ease,
            transform var(--_transition-duration) ease;

          @media (prefers-reduced-motion: reduce) {
            transition: none;
          }
        }

        #icon-open {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }

        #icon-close {
          opacity: 0;
          transform: scale(0.5) rotate(-90deg);
        }
      }

      #nav-panel {
        --_transition-duration: 0.3s;
        position: fixed;
        top: 0;
        right: 0;

        display: flex;
        justify-content: center;
        width: 40vw;
        height: 100vh;
        background-color: oklch(from var(--color-bg-elevated) l c h / 80%);
        transform: translateX(100%);
        transition: transform var(--_transition-duration) ease;

        @media (prefers-reduced-motion: reduce) {
          transition: none;
        }

        @supports (backdrop-filter: blur(4px)) {
          backdrop-filter: blur(4px);
        }

        #nav-pages {
          display: flex;
          visibility: hidden;
          flex-direction: column;
          width: 60%;
          padding: 0;
          margin: auto;
          font-size: var(--font-step-2);
          transition: visibility 0s var(--_transition-duration);
        }
      }
    }

    #nav-container:has(#nav-toggle[aria-expanded="true"]) {
      #nav-toggle {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 1001; /* Above #nav-panel */

        #icon-open {
          opacity: 0;
          transform: scale(0.5) rotate(90deg);
        }

        #icon-close {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }
      }

      #nav-panel {
        z-index: 1000;
        transform: translateX(0);

        #nav-pages {
          visibility: visible;
          transition: visibility 0s 0s;
        }
      }
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const navPages = document.getElementById("nav-pages");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));

    if (!isOpen) {
      navPages?.querySelector("a")?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) {
      return;
    }

    if (!(toggle?.contains(e.target) || navPages?.contains(e.target))) {
      toggle?.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>

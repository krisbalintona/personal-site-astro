---
import Link from "astro-typesafe-routes/link";
---

<header>
  <nav>
    <ul>
      <li><Link to="/">Home</Link></li>
      <li><Link to="/tags">Tags</Link></li>
    </ul>
  </nav>
</header>

<style>
  header {
    font-family: var(--font-ui);
    position: absolute;
    top: 0;
    left: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    height: 48px;
    padding: 0 2rem;
  }

  nav ul {
    display: flex;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
    letter-spacing: 0.05em;
  }
</style>

---
import { trailingSlash } from "astro:config/server";
import { Icon } from "astro-icon/components";
import Link from "astro-typesafe-routes/link";
import { $path, type RouteId, type Routes } from "astro-typesafe-routes/path";

type StaticRouteId = {
  [K in RouteId]: Routes[K]["params"] extends null ? K : never;
}[RouteId];

const TRAILING_SLASH = /\/$/;
const normalizeUrlPathname = (p: string): string => {
  if (trailingSlash === "always") {
    return p.endsWith("/") ? p : `${p}/`;
  }
  if (trailingSlash === "never") {
    return p.replace(TRAILING_SLASH, "") || "/";
  }
  // "ignore" - strip both sides for comparison
  return p.replace(TRAILING_SLASH, "") || "/";
};
const navItemCurrentId = (to: StaticRouteId) => {
  return normalizeUrlPathname(Astro.url.pathname) ===
    normalizeUrlPathname($path({ to }))
    ? "nav-page-current"
    : undefined;
};
const navItemCurrentClass = (to: StaticRouteId) => {
  return normalizeUrlPathname(Astro.url.pathname) ===
    normalizeUrlPathname($path({ to }))
    ? "link-strong"
    : undefined;
};
const navItems: { to: StaticRouteId; label: string }[] = [
  { to: "/", label: "home" },
  { to: "/about", label: "about" },
  { to: "/site-index", label: "index" },
  { to: "/explore", label: "explore" },
];
---

<div id="site-header">
  {
    /* Structure `header`,`nav`, and `button` according to
    https://dev.to/masakudamatsu/don-t-nest-nav-inside-header-do-nest-the-hamburger-menu-button-inside-nav-6cp
    */
  }
  <header></header>
  <nav id="nav-container" class="ui">
    {
      /* This wrapper serves three purposes on mobile:
      1. Positioning anchor: switches between `position: absolute`
         (menu closed) and `position: fixed` (menu open), lifting both
         the toggle and panel out of document flow so the header
         height is never inflated by them.
      2. Target for the `:has()` selector that drives the open state
         styles.
      3. Groups toggle + panel so they can be jointly repositioned as
         a unit.
       */
    }
    <div id="nav-mobile-fixed">
      <button
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-pages"
        aria-label="Open navigation menu"
        type="button"
      >
        <Icon
          name="ph:list"
          aria-hidden="true"
          focusable="false"
          id="icon-open"
        />
        <Icon
          name="ph:x"
          aria-hidden="true"
          focusable="false"
          id="icon-close"
        />
      </button>
      <div id="nav-panel">
        <ul id="nav-pages">
          {
            navItems.map(({ to, label }) => (
              <li>
                <Link
                  id={navItemCurrentId(to)}
                  class={navItemCurrentClass(to)}
                  to={to}
                >
                  {label}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</div>

<style>
  #site-header {
    top: 0;
    left: 0;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    width: 100%;
    margin: 0 0 var(--space-s-m) 0;
  }

  #nav-container {
    padding: 0;
    margin: 0;

    #nav-toggle {
      display: none;
      width: 100%;
      color: inherit;
      cursor: pointer;
      background: none;
      border: none;
    }

    #nav-pages {
      display: flex;
      gap: var(--space-2xs-xs);
      letter-spacing: 0.05em;
      list-style: none;

      & > li {
        & > a {
          --_transition-duration: 0.15s;

          opacity: var(--_nav-item-opacity, 0.65);

          /* We also add a transition to color to avoid an instance
          "opacity: 1" causing unexpected discoloration after hovering
          */
          transition:
            opacity var(--_transition-duration) ease-in,
            color var(--_transition-duration) ease-in;

          &:hover {
            --_nav-item-opacity: 1;
          }
        }
      }
    }
  }

  /* Must stay at top level because nesting inside any ID selector
  (e.g. #nav-pages) would add specificity, preventing `a:hover` in
  global.css from taking effect. */
  #nav-page-current {
    --_nav-item-opacity: 0.95;
  }

  @media (width <= 768px) {
    #site-header {
      min-height: var(--space-xl);
    }

    #nav-container {
      position: relative;
      display: block;

      #nav-mobile-fixed {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 1000;

        #nav-toggle {
          --_transition-duration: 0.2s;

          display: grid;
          justify-content: end;

          #icon-open,
          #icon-close {
            font-size: var(--font-step-2); /* Size of icons */
            z-index: 1001; /* Above #nav-mobile-fixed */
            grid-area: 1 / 1;
            margin-top: var(--space-s);
            transition:
              opacity var(--_transition-duration) ease,
              transform var(--_transition-duration) ease;

            @media (prefers-reduced-motion: reduce) {
              transition: none;
            }
          }

          #icon-open {
            opacity: 1;
            transform: scale(1) rotate(0deg);
          }

          #icon-close {
            opacity: 0;
            transform: scale(0.5) rotate(-90deg);
          }
        }

        #nav-panel {
          --_transition-duration: 0.3s;

          position: fixed;
          top: 0;
          left: 100%;
          display: flex;
          justify-content: center;
          width: min(60vw, 280px);
          height: 100vh;
          background-color: oklch(from var(--color-bg-elevated) l c h / 80%);
          transition: transform var(--_transition-duration) ease;

          @media (prefers-reduced-motion: reduce) {
            transition: none;
          }

          @supports (backdrop-filter: blur(4px)) {
            backdrop-filter: blur(4px);
          }

          #nav-pages {
            display: flex;
            visibility: hidden;
            flex-direction: column;
            width: 60%;
            padding-bottom: 33%;
            margin: auto;
            font-size: var(--font-step-2);
            transition: visibility 0s var(--_transition-duration);

            & > li > a {
              --_nav-item-opacity: 1;
            }
          }
        }
      }
    }

    #nav-mobile-fixed:has(#nav-toggle[aria-expanded="true"]) {
      position: fixed;

      #nav-toggle {
        #icon-open,
        #icon-close {
          margin-top: var(--space-m-l);
          margin-right: calc(var(--space-m-l) + var(--page-side-padding));
        }

        #icon-open {
          opacity: 0;
          transform: scale(0.5) rotate(90deg);
        }

        #icon-close {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }
      }

      #nav-panel {
        transform: translateX(-100%);

        #nav-pages {
          visibility: visible;
          transition: visibility 0s 0s;
        }
      }
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const navPages = document.getElementById("nav-pages");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute(
      "aria-label",
      isOpen ? "Open navigation menu" : "Close navigation menu",
    );

    if (!isOpen) {
      navPages?.querySelector("a")?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) {
      return;
    }

    if (!(toggle?.contains(e.target) || navPages?.contains(e.target))) {
      toggle?.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>

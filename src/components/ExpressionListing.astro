---
import {
  formatDate,
  getContentCollection,
  getEntryUrl,
  toDateTimeAttribute,
} from "@lib/entries";
import {
  allExpressions,
  type ExpressionCollection,
  type ExpressionEntry,
} from "@lib/expressions";
import { type CollectionEntry } from "astro:content";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  collections?: ExpressionCollection[];
  descending?: boolean;
  filter?: (expression: ExpressionEntry) => boolean;
}

const {
  collections,
  filter: filter = () => true,
  descending = true,
} = Astro.props;

const expressions = collections
  ? (
      await Promise.all(
        (Array.isArray(collections) ? collections : [collections]).map((c) =>
          getContentCollection(c, filter),
        ),
      )
    ).flat()
  : await allExpressions(filter);
const expressionItems: ListingItem[] = expressions
  .map(
    (expression: CollectionEntry<ExpressionCollection>): ListingItem => ({
      title: expression.data.title,
      pubDate: expression.data.pubDate,
      href: getEntryUrl(expression),
    }),
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
const hasItems = expressionItems.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{
  hasItems && (
    <ul class="expression-listing">
      {hasItems &&
        expressionItems.map((item: ListingItem) => (
          <li class="listing-item no-visited">
            <a class="title" href={item.href}>
              {item.title}
            </a>
            <a class="date" href={item.href}>
              <time datetime={toDateTimeAttribute(item.pubDate)}>
                {formatDate(item.pubDate)}
              </time>
            </a>
          </li>
        ))}
    </ul>
  )
}

<style>
  :where(.expression-listing) {
    padding: 0;
    margin: var(--space-l) 0 0 0;
    list-style: none;

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-s);

      a {
        --link-underline-color: transparent;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentcolor;
        }
      }
    }
  }
</style>

---
import {
  formatDate,
  getContentCollection,
  getEntryUrl,
  toDateTimeAttribute,
} from "@lib/entries";
import {
  allExpressions,
  type ExpressionCollection,
  type ExpressionEntry,
} from "@lib/expressions";
import Link from "astro-typesafe-routes/link";

interface Props {
  collections?: ExpressionCollection[];
  descending?: boolean;
  filter?: (expression: ExpressionEntry) => boolean;
  showType?: boolean;
}

const {
  collections,
  filter: filter = () => true,
  descending = true,
  showType = false,
} = Astro.props;

const expressions = collections
  ? (
      await Promise.all(collections.map((c) => getContentCollection(c, filter)))
    ).flat()
  : await allExpressions(filter);
const expressionsSorted = expressions.sort((a, b) => {
  const diff = a.data.pubDate.getTime() - b.data.pubDate.getTime();
  return descending ? -diff : diff;
});
const hasItems = expressionsSorted.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{
  hasItems && (
    <ul class="expression-listing">
      {hasItems &&
        expressionsSorted.map((entry) => (
          <li class="listing-item no-visited">
            <a href={getEntryUrl(entry)}>{entry.data.title}</a>
            <div class="expression-metadata">
              <time datetime={toDateTimeAttribute(entry.data.pubDate)}>
                {formatDate(entry.data.pubDate)}
              </time>
              {showType && (
                <Link class="item-type" to={`/${entry.collection}`}>
                  {entry.collection}
                </Link>
              )}
            </div>
          </li>
        ))}
    </ul>
  )
}

<style>
  :where(.expression-listing) {
    padding: 0;
    margin: var(--space-l) 0 0 0;
    list-style: none;

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-m);

      a {
        --link-underline-color: transparent;
      }

      .expression-metadata {
        display: flex;
        flex-direction: row;
        gap: var(--space-s);
        font-size: 0.95em;

        time {
          color: var(--color-text-muted);
        }

        .item-type {
          font-style: italic;
          color: var(--color-text-muted);

          &:hover {
            color: var(--color-text);
          }
        }
      }
    }
  }
</style>

---
import { type CollectionEntry, getCollection } from "astro:content";
import {
  formatDate,
  getEntryUrl,
  isPublished,
  toDateTimeAttribute,
} from "@lib/entries";
import type { ExpressionCollection, ExpressionEntry } from "@lib/expressions";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  collection: ExpressionCollection;
  descending?: boolean;
  extraFilter?: (expression: ExpressionEntry) => boolean;
}

const { collection, extraFilter = () => true, descending = true } = Astro.props;

const finalFilter = (expression: ExpressionEntry): boolean =>
  isPublished(expression) && extraFilter(expression);

const expressions = await getCollection(collection, finalFilter);
const expressionItems: ListingItem[] = expressions
  .map(
    (expression: CollectionEntry<ExpressionCollection>): ListingItem => ({
      title: expression.data.title,
      pubDate: expression.data.pubDate,
      href: getEntryUrl(expression),
    })
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
const hasItems = expressionItems.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{hasItems &&
  <ul class="expression-listing">
    {hasItems && expressionItems.map((item: ListingItem) => (
      <li class="listing-item no-visited">
        <a class="title" href={item.href}>{item.title}</a>
        <a class="date" href={item.href}>
          <time datetime={toDateTimeAttribute(item.pubDate)}>
            {formatDate(item.pubDate)}
          </time>
        </a>
      </li>
    ))}
  </ul>}

<style>
  :where(.expression-listing) {
    padding: 0;
    margin: var(--space-l) 0 0 0;
    list-style: none;

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-s);

      a {
        --link-underline-color: transparent;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentColor;
        }
      }
    }
  }
</style>

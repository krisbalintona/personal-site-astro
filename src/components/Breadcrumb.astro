---
import BreadcrumbLeaf, {
  type BreadcrumbLeafProps,
} from "@components/BreadcrumbLeaf.astro";

export type BreadcrumbComponent = BreadcrumbLeafProps | BreadcrumbLeafProps[];

interface Props {
  breadcrumbs: BreadcrumbComponent[];
}

const { breadcrumbs } = Astro.props;
---

<div class="breadcrumb-container">
  <div class="breadcrumb-components">
    {
      breadcrumbs.map((b, i) => (
        <>
          {Array.isArray(b) ? (
            // Is a BreadcrumbLeaf[]
            b.map((leaf, ci) => (
              <>
                <BreadcrumbLeaf {...leaf} />
                {ci !== b.length - 1 && (
                  <span aria-hidden="true" class="sep sep-child">
                    /
                  </span>
                )}
              </>
            ))
          ) : (
            // Is a BreadcrumbLeaf
            <BreadcrumbLeaf {...b} />
          )}
          {i !== breadcrumbs.length - 1 && (
            <span aria-hidden="true" class="sep">
              ·
            </span>
          )}
        </>
      ))
    }
    {
      Astro.slots.has("component-post") && (
        <span class="breadcrumb-component-post">
          <slot name="component-post" />
        </span>
      )
    }
  </div>
  {
    Astro.slots.has("description") && (
      <span class="breadcrumb-description">
        <slot name="description" />
      </span>
    )
  }
</div>

<style>
  .breadcrumb-container {
    margin-bottom: 1.5rem;
    font-size: var(--font-step--1);

    .breadcrumb-components {
      display: flex;
      align-items: baseline;

      .component {
        --link-underline-color: transparent;

        font-style: italic;
        color: var(--color-text-muted);
        transition: var(--transition-ui);

        &:hover {
          color: var(--color-text);
        }
      }

      .sep {
        padding: 0 0.3em;
        font-style: normal;
        color: var(--color-text-muted);
        user-select: none;

        &:not(.sep-child) {
          transform: scale(1.3);
        }
      }

      .sep-child {
        /* Shrink vertically without affecting font size or baseline */
        transform: scaleY(0.7);
      }

      .normal {
        font-style: normal;
        color: var(--color-text);
      }

      .breadcrumb-component-post:has(svg) {
        margin-left: 0.1em;

        /* Vertically center all SVG icons, since they don't have a
        baseline, which means `align-items: baseline` does not apply
        to it */
        align-self: center;
        line-height: 0;
      }
    }

    .breadcrumb-description {
      display: block;
      font-size: 0.85em;
      font-style: italic;
    }
  }
</style>

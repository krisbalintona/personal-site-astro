---
import BreadcrumbLeaf, {
  type BreadcrumbLeafProps,
} from "@components/BreadcrumbLeaf.astro";

export type BreadcrumbComponent = BreadcrumbLeafProps | BreadcrumbLeafProps[];

interface Props {
  breadcrumbs: BreadcrumbComponent[];
  description?: string;
}

const { breadcrumbs, description } = Astro.props;
---

<div class="breadcrumb-container">
  <div class="breadcrumb-components">
    {
      breadcrumbs.map((b, i) => (
        <>
          {Array.isArray(b) ? (
            // Is a BreadcrumbLeaf[]
            b.map((leaf, ci) => (
              <>
                <BreadcrumbLeaf {...leaf} />
                {ci !== b.length - 1 && (
                  <span aria-hidden="true" class="sep sep-child">
                    /
                  </span>
                )}
              </>
            ))
          ) : (
            // Is a BreadcrumbLeaf
            <BreadcrumbLeaf {...b} />
          )}
          {i !== breadcrumbs.length - 1 && (
            <span aria-hidden="true" class="sep">
              ·
            </span>
          )}
        </>
      ))
    }
  </div>
  {description && <span id="breadcrumb-description">{description}</span>}
</div>

<style>
  .breadcrumb-container {
    margin-bottom: 1.5rem;
    font-size: var(--font-step--1);

    .breadcrumb-components {
      display: flex;
      align-items: baseline;

      .component {
        --link-underline-color: transparent;

        font-style: italic;
        color: var(--color-text-muted);
        transition: var(--transition-ui);

        &:hover {
          color: var(--color-text);
        }
      }

      .sep {
        padding: 0 0.3em;
        font-style: normal;
        color: var(--color-text-muted);
        user-select: none;
      }

      .sep-child {
        /* Shrink vertically without affecting font size or baseline */
        transform: scaleY(0.7);
      }

      .normal {
        font-style: normal;
        color: var(--color-text);
      }
    }

    #breadcrumb-description {
      display: block;
      font-size: 0.85em;
      font-style: italic;
    }
  }
</style>

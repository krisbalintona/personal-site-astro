---
import { Icon } from "astro-icon/components";
---

<div role="radiogroup" aria-label="Theme">
  <button
    class="like-link"
    role="radio"
    aria-checked="false"
    data-theme-value="light"
  >
    <Icon name="ph:sun-bold" aria-hidden="true" focusable="false" />
  </button>
  <button
    class="like-link"
    role="radio"
    aria-checked="false"
    data-theme-value="dark"
  >
    <Icon name="ph:moon-bold" aria-hidden="true" focusable="false" />
  </button>
  <button
    class="like-link"
    role="radio"
    aria-checked="true"
    data-theme-value="system"
  >
    <Icon name="ph:monitor-bold" aria-hidden="true" focusable="false" />
  </button>
</div>

<style>
  button {
    background-color: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    font-size: inherit;
    color: inherit;
    cursor: pointer;
  }

  /* When light theme */
  :global([data-theme="light"]) {
    svg[data-icon="ph:moon-bold"] {
      display: none;
    }

    svg[data-icon="ph:monitor-bold"] {
      display: none;
    }
  }

  /* When dark theme */
  :global([data-theme="dark"]) {
    svg[data-icon="ph:sun-bold"] {
      display: none;
    }

    svg[data-icon="ph:monitor-bold"] {
      display: none;
    }
  }

  /* When system theme */
  :global([data-theme="system"]) {
    svg[data-icon="ph:sun-bold"] {
      display: none;
    }

    svg[data-icon="ph:moon-bold"] {
      display: none;
    }
  }
</style>

<style is:global>
  .theme-transitioning,
  .theme-transitioning *,
  .theme-transitioning *::before,
  .theme-transitioning *::after {
    --transition-duration: 0.4s;

    transition:
      background-color var(--transition-duration) ease,
      color var(--transition-duration) ease,
      border-color var(--transition-duration) ease !important;
  }
</style>

{
  /* Must be run immediately on page load, so must be `is:inline` (not
  bundled as a separate module */
}
<script is:inline>
  const root = document.documentElement;
  const buttons = document.querySelectorAll("[data-theme-value]");
  const initialState =
    localStorage.getItem("theme") ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  function setTheme(theme) {
    localStorage.setItem("theme", theme);
    root.setAttribute("data-theme", theme);
    buttons.forEach((btn) => {
      const value = btn.dataset.themeValue;
      const labelLower = value.charAt(0).toLowerCase() + value.slice(1);
      const labelUpper = value.charAt(0).toUpperCase() + value.slice(1);
      btn.setAttribute("aria-checked", value === theme);
      btn.setAttribute(
        "aria-label",
        value === theme
          ? `${labelUpper} theme, selected`
          : `Switch to ${labelLower} theme`,
      );
      btn.setAttribute(
        "title",
        value === theme
          ? `${labelUpper} theme, selected`
          : `Switch to ${labelLower} theme`,
      );
    });
  }

  // Immediately set theme on page load/refresh
  setTheme(initialState);

  // Theme toggle button
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      // Temporarily add a transition to every element so the change
      // of colors is not sudden
      root.classList.add("theme-transitioning");
      window.setTimeout(() => {
        root.classList.remove("theme-transitioning");
      }, 400);

      // Switch to next theme
      const themes = { light: "dark", dark: "system", system: "light" };
      const nextTheme = themes[btn.dataset.themeValue];
      setTheme(nextTheme);
    }),
  );
</script>

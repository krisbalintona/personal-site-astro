---
import { footnoteSectionHeadingId } from "@components/markup/FootnoteSection.astro";

type Props =
  | { isTopLevel: true; headingText: string; footnotesLinkText: string }
  | { isTopLevel?: false; headingText?: never; footnotesLinkText: never };

const { isTopLevel = true, headingText, footnotesLinkText } = Astro.props;
---

<nav
  aria-label={isTopLevel ? undefined : "Section contents"}
  aria-labelledby={isTopLevel ? "top-level-toc" : undefined}
  class={isTopLevel ? undefined : "subtree-toc"}
>
  {isTopLevel && <h2 id="top-level-toc">{headingText}</h2>}
  <ul>
    {/* The default slot should contain the list items for the TOC */}
    <slot />
    {
      footnotesLinkText && (
        <li><a href=`#${footnoteSectionHeadingId}`>{footnotesLinkText}</a></li>
      )
    }
  </ul>
</nav>

<style>
  nav {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-soft);
    border-radius: 0.15em;
    margin: var(--space-m) 0 var(--space-l) 0;

    &:has(h2#top-level-toc) {
      padding: var(--space-m) var(--space-s) var(--space-xs) var(--space-m);
    }

    &.subtree-toc {
      padding: var(--space-s) var(--space-xs);

      ul {
        margin-top: 0;
      }
    }

    h2 {
      margin-top: 0;
    }

    ul {
      margin-bottom: 0;
    }
  }
</style>

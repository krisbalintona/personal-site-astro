---
import { type CollectionEntry, getCollection } from "astro:content";
import Listing, { type ListingItem } from "@components/Listing.astro";
import isPublished from "@lib/isPublished";
import type { PostEntry } from "@lib/posts";
import { $path } from "astro-typesafe-routes/path";

interface Props {
  descending?: boolean;
  extraFilter?: (entry: PostEntry) => boolean;
}

const { extraFilter = () => true, descending = true } = Astro.props;

const finalFilter = (entry: PostEntry): boolean =>
  isPublished(entry) && extraFilter(entry);

const articles = await getCollection("articles", finalFilter);
const articleItems: ListingItem[] = articles
  .map(
    (article: CollectionEntry<"articles">): ListingItem => ({
      title: article.data.title,
      pubDate: article.data.pubDate,
      href: $path({
        to: "/articles/[titleSlug]",
        params: { titleSlug: article.data.titleSlug },
      }),
    })
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
---

<div class="article-listing">
  <Listing items={articleItems} />
</div>

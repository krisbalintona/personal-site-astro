---
import { type CollectionEntry, getCollection } from "astro:content";
import Listing, { type ListingItem } from "@components/Listing.astro";
import isPublished from "@lib/isPublished";
import type { AnyPost } from "@src/content.config";

interface Props {
  extraFilter?: (entry: AnyPost) => boolean;
}

const { extraFilter = () => true } = Astro.props;

const finalFilter = (entry: AnyPost): boolean =>
  isPublished(entry) && extraFilter(entry);

const articles = await getCollection("articles", finalFilter);
const articleItems: ListingItem[] = articles.map(
  (article: CollectionEntry<"articles">): ListingItem => ({
    title: article.data.title,
    date: article.data.date,
    href: `/articles/${article.data.slug}`,
  })
);
---

<Listing items={articleItems} />

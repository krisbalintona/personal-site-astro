---
import { type CollectionEntry, getCollection } from "astro:content";
import { formatDate, toDateTimeAttribute } from "@lib/date";
import isPublished from "@lib/isPublished";
import type { PostEntry } from "@lib/posts";
import { $path } from "astro-typesafe-routes/path";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  descending?: boolean;
  extraFilter?: (entry: PostEntry) => boolean;
}

const { extraFilter = () => true, descending = true } = Astro.props;

const finalFilter = (entry: PostEntry): boolean =>
  isPublished(entry) && extraFilter(entry);

const articles = await getCollection("articles", finalFilter);
const articleItems: ListingItem[] = articles
  .map(
    (article: CollectionEntry<"articles">): ListingItem => ({
      title: article.data.title,
      pubDate: article.data.pubDate,
      href: $path({
        to: "/articles/[titleSlug]",
        params: { titleSlug: article.data.titleSlug },
      }),
    })
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
const hasItems = articleItems.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{hasItems &&
  <ul class="article-listing">
    {hasItems && articleItems.map((item: ListingItem) => (
      <li class="listing-item">
        <a class="title" href={item.href}>{item.title}</a>
        <a class="date" href={item.href}>
          <time class="no-visited" datetime={toDateTimeAttribute(item.pubDate)}>
            {formatDate(item.pubDate)}
          </time>
        </a>
      </li>
    ))}
  </ul>}

<style lang="scss">
  @use "mixins";

  .article-listing {
    margin: var(--space-l) 0 0 0;
    padding: 0;
    list-style: none;
    @include mixins.breakout(var(--space-s-m));

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-s);

      a {
        border-bottom: none;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentColor;
        }
      }
    }
  }
</style>

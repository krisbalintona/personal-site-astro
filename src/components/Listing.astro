---
import { formatDate, toDateTimeAttribute } from "@lib/date";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  classes: string[];
  items: ListingItem[];
}

const { items, classes } = Astro.props;
const hasItems = items.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
<ul class:list={[...classes, "listing"]}>
  {hasItems && items.map((item: ListingItem) => (
    <li class="listing-item">
      <a class="title" href={item.href}>{item.title}</a>
      <time class="date" datetime={toDateTimeAttribute(item.pubDate)}>
        {formatDate(item.pubDate)}
      </time>
    </li>
  ))}
</ul>

<style>
  .listing {
    padding: 30px 0;
    margin: 0;
    list-style: none;

    .listing-item {
      display: flex;
      flex-direction: column;
      margin-bottom: 1em;

      a {
        color: var(--color-text);
      }

      a:hover {
        color: var(--color-accent);
      }

      a,
      time {
        border-bottom: none;
      }

      time {
        color: var(--color-text-muted);
      }
    }
  }
</style>

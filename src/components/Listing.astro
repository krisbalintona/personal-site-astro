---
import { formatDate, toDateTimeAttribute } from "@lib/date";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  classes: string[];
  items: ListingItem[];
}

const { items, classes } = Astro.props;
const hasItems = items.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
<ul class:list={[...classes, "listing"]}>
  {hasItems && items.map((item: ListingItem) => (
    <li class="listing-item">
      <a class="title" href={item.href}>{item.title}</a>
      <a class="date" href={item.href}>
        <time class="no-visited" datetime={toDateTimeAttribute(item.pubDate)}>
          {formatDate(item.pubDate)}
        </time>
      </a>
    </li>
  ))}
</ul>

<style lang="scss">
  @use "mixins";

  .listing {
    margin: 0;
    margin-top: var(--space-l);
    list-style: none;
    @include mixins.breakout(var(--space-m-l));

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-s);

      a {
        border-bottom: none;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentColor;
        }
      }
    }
  }
</style>

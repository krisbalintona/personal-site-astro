---
import { formatDate, toDateTimeAttribute } from "@lib/date";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  classes: string[];
  items: ListingItem[];
}

const { items, classes } = Astro.props;
const hasItems = items.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
<ul class:list={[...classes, "listing"]}>
  {hasItems && items.map((item: ListingItem) => (
    <li class="listing-item">
      <a class="title" href={item.href}>{item.title}</a>
      <a class="date" href={item.href}><time class="no-visited" datetime={toDateTimeAttribute(item.pubDate)}>{formatDate(item.pubDate)}</time></a>
    </li>
  ))}
</ul>

<style>
  .listing {
    padding: 30px 0;
    margin: 0;
    list-style: none;

    .listing-item {
      display: inline-flex;
      flex-direction: column;
      padding-bottom: 1em;

      a {
        border-bottom: none;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentColor;
        }
      }
    }
  }
</style>

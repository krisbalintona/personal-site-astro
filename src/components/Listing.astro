---
export interface ListingItem {
  date: Date;
  href: string;
  title: string;
}

const { items } = Astro.props;
const hasItems = items.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
<ul>
  {hasItems && items.map((item: ListingItem) => (
  <li>
    <article>
      <a href={item.href}>{item.title}</a>,
    posted on {item.date}
    </article>
  </li>
))}
</ul>

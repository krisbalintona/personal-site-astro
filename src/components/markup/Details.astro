---
---

<details>
  <summary class="interior-container"><slot name="summary" /></summary>

  <div class="content interior-container"><slot /></div>
</details>

<style>
  details {
    margin: var(--space-s-m) var(--space-2xs-xs);

    summary {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.5em;
      align-items: baseline;
      padding: var(--space-3xs-2xs) var(--space-s-m);
      cursor: pointer;
      background-color: var(--color-bg-surface);
      border-radius: 0.3rem;
      box-shadow: 0 2px 4px var(--color-bg-accent);
    }

    summary::before {
      font-size: 0.8em;
      content: "▶";
      transition: transform 0.2s ease;
    }

    &[open] summary::before {
      transform: rotate(90deg);
    }

    summary:focus-visible {
      outline: 2px solid var(--color-border);
    }

    .content {
      padding: var(--space-3xs) var(--space-xs-s) var(--space-s);
      background-color: color-mix(
        in srgb,
        var(--color-bg-elevated) 90%,
        var(--color-text)
      );
      border-radius: 0.2rem;
    }
  }
</style>

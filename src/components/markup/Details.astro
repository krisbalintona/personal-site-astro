---
---

<details>
  <summary class="interior-container"><slot name="summary" /></summary>

  <div class="content interior-container"><slot /></div>
</details>

<style>
  details {
    margin-top: var(--space-s);
    margin-bottom: var(--space-s-m);
    background-color: var(--color-bg-surface);
    border-radius: 5px;
    box-shadow: 0 0.1rem 1rem -0.5rem var(--color-bg-accent);

    summary {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-xs);
      align-items: baseline;
      padding: var(--space-2xs-xs) var(--space-2xs-xs);
      cursor: pointer;

      &::before {
        display: inline-block;
        margin-left: var(--space-xs);
        font-size: 0.8em;
        content: "▶";
        transform-origin: center center;
        transition: transform 0.2s ease;
      }

      &::-webkit-details-marker {
        display: none;
      }
    }

    &[open] {
      summary::before {
        transform: rotate(90deg);
      }
    }

    summary:focus-visible {
      outline: 2px solid var(--color-border);
    }

    .content {
      padding: var(--space-3xs) var(--space-xs-s) var(--space-s);
      background-color: var(--color-bg-elevated);
      border-radius: 0.2rem;
    }
  }
</style>

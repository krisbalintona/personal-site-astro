<!-- We use a blockquote instead of e.g. a div for the sake of RSS
feed readers: after sanitizing the HTML, the blockquote tag is the
closest to conveying meaning of this component -->
<blockquote class="alert" role="note">
  <div class="content interior-container"><slot /></div>
</blockquote>

<style>
  .alert {
    --_alert-bg: var(--blue-subtle);

    display: flex;
    gap: 0.8em;
    align-items: flex-start;
    padding: var(--space-2xs-xs) var(--space-xs-s);
    margin-block: var(--space-xs-s);
    margin-inline: 0;
    font-size: 0.9em;
    line-height: 2.2;
    background-color: var(--_alert-bg);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--blue);

    &::before {
      flex-shrink: 0;
      margin-top: 0.125em;
      font-size: var(--font-step-0);
      color: var(--blue);
      content: "ℹ";
    }

    .content {
      min-width: 0;
      background-color: var(--_alert-bg);

      /* Special styling for timestamps */
      :global(.ts) {
        --ts-bg: var(--background);
      }
    }
  }
</style>

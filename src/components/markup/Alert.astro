<!-- We use a blockquote instead of e.g. a div for the sake of RSS
feed readers: after sanitizing the HTML, the blockquote tag is the
closest to conveying meaning of this component -->
<blockquote class="alert interior-container" role="note"><slot /></blockquote>

<style>
  .alert {
    --_alert-bg: var(--color-bg-surface);
    --_alert-accent: var(--color-bg-accent);

    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8em;
    align-items: baseline;
    padding: var(--space-2xs-xs) var(--space-xs-s);
    margin-block: var(--space-xs-s);
    margin-inline: 0;
    font-size: 0.9em;
    line-height: 2.2;
    background-color: var(--_alert-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--_alert-accent);

    &::before {
      margin-top: 0.125em;
      font-size: var(--font-step-0);
      color: var(--_alert-accent);
      content: "ℹ";
    }

    /* Special styling for timestamps */
    :global(.ts) {
      --ts-bg: var(--color-bg);
    }
  }
</style>

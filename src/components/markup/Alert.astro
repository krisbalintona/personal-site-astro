<!-- We use a blockquote instead of e.g. a div for the sake of RSS
feed readers: after sanitizing the HTML, the blockquote tag is the
closest to conveying meaning of this component -->
<blockquote class="alert" role="note">
  <div class="alert-body"><slot /></div>
</blockquote>

<style>
  .alert {
    display: flex;
    gap: 0.8em;
    align-items: flex-start;
    padding: 0.75rem 1rem;
    margin-block: 1rem;
    margin-inline: 0;
    font-size: 0.9em;
    line-height: 2.2;
    background-color: var(--blue-subtle);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--blue);

    &::before {
      flex-shrink: 0;
      margin-top: 0.125rem;
      font-size: 1rem;
      color: var(--blue);
      content: "ℹ";
    }

    .alert-body {
      /* Override the flex default of `min-width: auto`, which */
      /* prevents flex children from shrinking below their content's */
      /* intrinsic width. Without this, long unbreakable content (e.g. */
      /* URLs, code) would overflow the container instead of wrapping. */
      min-width: 0;
    }

    /* Special styling for timestamps */
    :global(.ts) {
      --ts-bg: var(--background);
    }
  }
</style>

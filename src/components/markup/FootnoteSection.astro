---
import type { HTMLTag } from "astro/types";

interface Props {
  headingLevel?: number | string;
}

const { headingLevel } = Astro.props;
const FootnoteHeading = (
  headingLevel ? headingLevel.toString() : "h2"
) as HTMLTag;
const footnoteSectionHeadingId = "footnotes-heading";
---

<footer aria-labelledby={footnoteSectionHeadingId}>
  <FootnoteHeading id={footnoteSectionHeadingId}
    ><slot>Footnotes</slot></FootnoteHeading
  >

  {Astro.slots.has("footnotes") &&
    <ol>
      <slot name="footnotes"/>
    </ol>}
</footer>

<style>
  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>

---
import type { HeadingTag } from "@components/markup/Heading.astro";
import Heading from "@components/markup/Heading.astro";

interface Props {
  headingLevel?: HeadingTag;
  headingText?: string;
}

const { headingLevel, headingText = "Footnotes" } = Astro.props;
export const footnoteSectionHeadingId = "footnotes-heading";
---

<footer aria-labelledby={footnoteSectionHeadingId}>
  <Heading
    level={headingLevel ?? "2"}
    id={footnoteSectionHeadingId}
    selfLink={true}>{headingText}</Heading
  >

  {
    Astro.slots.has("footnotes") && (
      <ol>
        <slot name="footnotes" />
      </ol>
    )
  }
</footer>

<style>
  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>

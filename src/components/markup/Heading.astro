---
import type { HTMLAttributes } from "astro/types";

type HeadingTag = "1" | "2" | "3" | "4" | "5" | "6";

const headingOptions = {
  "1": "h1",
  "2": "h2",
  "3": "h3",
  "4": "h4",
  "5": "h5",
  "6": "h6",
};

type BaseProps = HTMLAttributes<"h1" | "h2" | "h3" | "h4" | "h5" | "h6"> & {
  level: HeadingTag;
};

// Disallow `selfLink` being true while `id` is undefined
type Props =
  | (BaseProps & { selfLink?: false })
  | (BaseProps & { selfLink: true; id: string });

const { level, id, class: classSpecified, selfLink, ...rest } = Astro.props;
const HeadingLevel = headingOptions[level] as HeadingTag;
---

<HeadingLevel
  id={id}
  class:list={["heading", level, "no-visited", classSpecified]}
  {...rest}
  ><slot />
  {selfLink && <a class="self-link" aria-label="Link to this section" href={`#${id}`}> §</a>}
</HeadingLevel>

<style>
  :where(.heading) {
    text-wrap: balance;

    a {
      --link-underline-color: transparent;
    }
    
    .self-link {
      color: var(--color-accent);
      opacity: 0;

      &:hover {
        color: var(--color-accent-emphasis);
      }
    }

    &:hover > .self-link {
      opacity: 1;
    }
  }
</style>

---
import type { HTMLAttributes } from "astro/types";

type HeadingTag = "1" | "2" | "3" | "4" | "5" | "6";

const headingOptions = {
  "1": "h1",
  "2": "h2",
  "3": "h3",
  "4": "h4",
  "5": "h5",
  "6": "h6",
};

interface Props
  extends HTMLAttributes<"h1" | "h2" | "h3" | "h4" | "h5" | "h6"> {
  level: HeadingTag;
  selfLink?: boolean;
}

const {
  level,
  id,
  class: classSpecified,
  selfLink = true,
  ...rest
} = Astro.props;
const HeadingLevel = headingOptions[level] as HeadingTag;
---

<HeadingLevel
  id={id}
  class:list={["heading", level, "no-visited", classSpecified]}
  {...rest}
  ><slot />
  {selfLink && <a aria-label="Link to this section" href={`#${id}`}> §</a>}</HeadingLevel
>

<style>
  :where(.heading) {
    text-wrap: balance;

    a {
      --a-border-style: none;
      color: var(--color-accent);
      opacity: 0;

      &:visited {
        color: var(--color-accent);
      }
    }

    &:hover > a {
      opacity: 1;
    }
  }
</style>

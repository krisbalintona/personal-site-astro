---
interface Props {
  class?: string;
  id?: string;
  level: number;
  selfLink?: boolean;
}

const { level, id, class: className, selfLink } = Astro.props;
const HeadingLevel = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
---

<HeadingLevel id={id} class:list={["no-visited", className]}
  ><slot />
  {selfLink && <a aria-label="Link to this section" href={`#${id}`}> §</a>}</HeadingLevel
>

<style>
  a {
    --a-border-style: none;
    color: var(--color-accent);
    opacity: 0;

    &:visited {
      color: var(--color-accent);
    }
  }

  :is(h1, h2, h3, h4, h5, h6):hover > a {
    opacity: 1;
  }
</style>

---
interface Props {
  num: string;
}

const { num } = Astro.props;
---

<li class="ui" id={`fn-${num}`}>
  {/* For sighted users */}
  {/* biome-ignore lint/a11y/useAnchorContent: decorative duplicate of sr-only backref */}
  <a
    href={`#fnref-${num}`}
    class="fn-marker"
    aria-label={`Return to footnote ${num} reference`}
    aria-hidden="true"
    tabindex="-1"
    >[{num}]</a
  >
  <div class="fn-content">
    <slot />
    {/* For screen readers */}
    <a
      href={`#fnref-${num}`}
      class="sr-only"
      aria-label={`Return to footnote ${num} reference`}
      >↩</a
    >
  </div>
</li>

<style>
  li {
    --border-left: 2px;

    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5em;
    align-items: baseline;
    padding-left: 0.5em;
    margin-bottom: 1.2rem;
    border-left: var(--border-left) solid transparent;
  }

  li:target {
    animation: highlight-fade 6s ease;
  }

  @keyframes highlight-fade {
    0%,
    80% {
      border-left: var(--border-left) solid var(--color-accent);
    }
    100% {
      border-left: var(--border-left) solid transparent;
    }
  }

  .fn-marker {
    font-family: var(--font-ui);
    color: var(--color-accent);
    border-bottom: unset;
  }

  .fn-content > :global(*:first-child) {
    margin-top: 0;
  }

  /* We want the penultimate element since The final element */
  /* is the sr-only `a` tag */
  .fn-content > :global(*:nth-last-child(2)) {
    margin-bottom: 0;
  }
</style>

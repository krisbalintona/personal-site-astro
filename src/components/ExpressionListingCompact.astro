---
import { type CollectionEntry, getCollection } from "astro:content";
import {
  formatDate,
  getEntryUrl,
  isPublished,
  toDateTimeAttribute,
} from "@lib/entries";
import type { ExpressionCollection, ExpressionEntry } from "@lib/expressions";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  collections: ExpressionCollection[];
  descending?: boolean;
  extraFilter?: (expression: ExpressionEntry) => boolean;
}

const {
  collections,
  extraFilter = () => true,
  descending = true,
} = Astro.props;

const finalFilter = (expression: ExpressionEntry): boolean =>
  isPublished(expression) && extraFilter(expression);

const expressions = (
  await Promise.all(
    (Array.isArray(collections) ? collections : [collections]).map((c) =>
      getCollection(c, finalFilter)
    )
  )
).flat();
const expressionItems: ListingItem[] = expressions
  .map(
    (expression: CollectionEntry<ExpressionCollection>): ListingItem => ({
      title: expression.data.title,
      pubDate: expression.data.pubDate,
      href: getEntryUrl(expression),
    })
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
const hasItems = expressionItems.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{hasItems &&
  <ol class="expression-listing">
    {hasItems && expressionItems.map((item: ListingItem) => (
      <li class="listing-item no-visited">
        <a class="title" href={item.href}>{item.title}</a>
        <a class="date" href={item.href}>
          <time datetime={toDateTimeAttribute(item.pubDate)}>
            {formatDate(item.pubDate)}
          </time>
        </a>
      </li>
    ))}
  </ol>}

<style>
  :where(.expression-listing) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    padding: 0 var(--space-s) 0 0;
    margin: var(--space-m) 0 0 0;
    counter-reset: expression-counter;

    .listing-item {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      column-gap: var(--space-2xs);
      align-items: center;
      padding-bottom: var(--space-xs);
      list-style: none;
      counter-increment: expression-counter;

      &::before {
        align-self: center;
        font-size: small;
        color: var(--color-text-muted);
        content: counter(expression-counter) ".";
      }

      a {
        --link-underline-color: transparent;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentColor;
        }
      }
    }
  }
</style>

---
import {
  formatDate,
  getContentCollection,
  getEntryUrl,
  toDateTimeAttribute,
} from "@lib/entries";
import {
  allExpressions,
  type ExpressionCollection,
  type ExpressionEntry,
} from "@lib/expressions";
import { type CollectionEntry } from "astro:content";

export interface ListingItem {
  href: string;
  pubDate: Date;
  title: string;
}

interface Props {
  browseAllLink?: string;
  collections?: ExpressionCollection[];
  descending?: boolean;
  filter?: (expression: ExpressionEntry) => boolean;
  limit?: number;
}

const {
  browseAllLink,
  collections,
  filter: filter = () => true,
  descending = true,
  limit,
} = Astro.props;

const expressions = collections
  ? (
      await Promise.all(collections.map((c) => getContentCollection(c, filter)))
    ).flat()
  : await allExpressions();
const expressionItems: ListingItem[] = expressions
  .map(
    (expression: CollectionEntry<ExpressionCollection>): ListingItem => ({
      title: expression.data.title,
      pubDate: expression.data.pubDate,
      href: getEntryUrl(expression),
    }),
  )
  .sort((a, b) => {
    const diff = a.pubDate.getTime() - b.pubDate.getTime();
    return descending ? -diff : diff;
  });
const displayItems = limit ? expressionItems.slice(0, limit) : expressionItems;
const hasItems = displayItems.length > 0;
const itemCount = expressionItems.length;
---

{!hasItems && <p>Nothing yet...</p>}
{
  hasItems && (
    <div class="listing-wrapper expression-listing-wrapper">
      {/* Note: `reversed={descending}` has no visual effect (we set
    `list-style: none` below, removing the native markers), but
    preserves semantics for screen readers that announce list order
    */}
      <ol
        class="compact-listing expression-listing"
        reversed={descending}
        style={`--counter-start: ${descending ? itemCount + 1 : 0}; --counter-increment: ${descending ? -1 : 1}`}
      >
        {displayItems.map((item: ListingItem) => (
          <li class="listing-item no-visited">
            <a class="title" href={item.href}>
              {item.title}
            </a>
            <a class="date" href={item.href}>
              <time datetime={toDateTimeAttribute(item.pubDate)}>
                {formatDate(item.pubDate)}
              </time>
            </a>
          </li>
        ))}
      </ol>
      {browseAllLink && (
        <div class="browse-all">
          <small>
            <a href={browseAllLink}>Browse all {itemCount} entries</a>
          </small>
        </div>
      )}
    </div>
  )
}

<style>
  :where(.expression-listing-wrapper) {
    padding: 0 var(--space-3xs-2xs) 0 var(--space-s);
    margin-bottom: var(--space-m);
  }

  .expression-listing {
    display: grid;
    grid-template-columns: auto 1fr auto;
    padding: 0 var(--space-s) 0 0;
    margin: var(--space-m) 0 0 0;
    counter-reset: expression-counter var(--counter-start);

    .listing-item {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      column-gap: var(--space-2xs);
      align-items: center;
      padding-bottom: var(--space-xs);
      list-style: none;
      counter-increment: expression-counter var(--counter-increment);

      &::before {
        align-self: center;
        font-size: small;
        color: var(--color-text-muted);
        content: counter(expression-counter) ".";
      }

      a {
        --link-underline-color: transparent;
      }

      .title {
        color: var(--color-text);

        &:hover {
          color: var(--color-accent);
        }
      }

      .date {
        color: var(--color-text-muted);

        &:hover {
          color: currentcolor;
        }
      }
    }
  }

  .browse-all {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xs);
    font-size: var(--font-step--1);
  }
</style>

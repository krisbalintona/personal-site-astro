---
import {
  formatDate,
  getContentCollection,
  getEntryUrl,
  toDateTimeAttribute,
} from "@lib/entries";
import { allPosts, type PostCollection, type PostEntry } from "@lib/posts";
import Link from "astro-typesafe-routes/link";

interface Props {
  collections?: PostCollection[];
  descending?: boolean;
  filter?: (post: PostEntry) => boolean;
  showType?: boolean;
}

const {
  collections,
  filter: filter = () => true,
  descending = true,
  showType = false,
} = Astro.props;

const posts = collections
  ? (
      await Promise.all(collections.map((c) => getContentCollection(c, filter)))
    ).flat()
  : await allPosts(filter);
const postsSorted = posts.sort((a, b) => {
  const diff = a.data.pubDate.getTime() - b.data.pubDate.getTime();
  return descending ? -diff : diff;
});
const hasItems = postsSorted.length > 0;
---

{!hasItems && <p>Nothing yet...</p>}
{
  hasItems && (
    <ul class="post-listing">
      {hasItems &&
        postsSorted.map((entry) => (
          <li class="listing-item no-visited">
            <a href={getEntryUrl(entry)} set:html={entry.data.title} />
            <div class="post-metadata">
              <div class="dates">
                <time datetime={toDateTimeAttribute(entry.data.pubDate)}>
                  {formatDate(entry.data.pubDate)}
                </time>
                {entry.data.lastMod && (
                  <span class="last-mod">
                    (Last updated:
                    <time datetime={toDateTimeAttribute(entry.data.lastMod)}>
                      {formatDate(entry.data.lastMod)}
                    </time>
                    )
                  </span>
                )}
              </div>
              {showType && (
                <Link class="item-type" to={`/${entry.collection}`}>
                  {entry.collection}
                </Link>
              )}
            </div>
          </li>
        ))}
    </ul>
  )
}

<style>
  :where(.post-listing) {
    padding: 0;
    margin: var(--space-l) 0 0 0;
    list-style: none;

    .listing-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: var(--space-m);

      a {
        --link-underline-color: transparent;
      }

      .post-metadata {
        display: flex;
        flex-direction: row;
        gap: var(--space-s);
        font-size: 0.95em;

        time {
          color: var(--color-text-muted);
        }

        .last-mod {
          color: var(--color-text-muted);
          font-size: 0.87em;
        }

        .item-type {
          font-style: italic;
          color: var(--color-text-muted);

          &:hover {
            color: var(--color-text);
          }
        }
      }
    }
  }
</style>

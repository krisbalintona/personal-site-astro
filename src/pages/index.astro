---
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";

const bio = await getEntry("standalone", "bio");
const { Content } = bio ? await render(bio) : { Content: undefined };
---

<BaseLayout
  pageTitle="Home"
  displayTitle="Kristoffer Balintona &mdash; Personal site"
>
  {bio && isPublished(bio) && Content && <article><Content /></article>}
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import { getEntry, render } from "astro:content";

const home = await getEntry("standalone", "about");
const { Content } = home ? await render(home) : { Content: undefined };
---

<BaseLayout
  pageTitle="Home"
  displayTitle="Kristoffer Balintona — Personal site"
>
  {
    home && isPublished(home) && Content && (
      <article>
        <Content />
      </article>
    )
  }
</BaseLayout>

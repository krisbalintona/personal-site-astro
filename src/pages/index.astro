---
import { getEntry, render } from "astro:content";
import Heading from "@components/markup/Heading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";

const bio = await getEntry("standalone", "bio");
const { Content } = bio ? await render(bio) : { Content: null };
---

<BaseLayout pageTitle="Home">
  <Heading class="sr-only" level="1"
    >Kristoffer Balintona &mdash; Personal site</Heading
  >
  {bio && isPublished(bio) && Content && <article><Content /></article>}
</BaseLayout>

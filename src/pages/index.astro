---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentEntry, renderContent } from "@lib/entries";

const home = await getContentEntry("standalone", "about");
const { Content } = await renderContent(home);
---

<BaseLayout
  pageTitle="Home"
  displayTitle="Kristoffer Balintona — Personal site"
>
  {
    Content && (
      <article>
        <Content />
      </article>
    )
  }
</BaseLayout>

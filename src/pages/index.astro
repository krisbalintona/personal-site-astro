---
import { posts } from "@lib/posts";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle: string = "Home page";
---

<BaseLayout pageTitle={pageTitle}>
  This is home!

  {posts.map((post) => (
      <li>
        <a href={`posts/${post.slug}`}>{post.title}</a>, posted on {post.date}
      </li>
    ))}
</BaseLayout>

---
import Heading from "@components/markup/Heading.astro";
import PostListingCompact from "@components/PostListingCompact.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentEntry, renderContent } from "@lib/entries";
import Link from "astro-typesafe-routes/link";

const home = await getContentEntry("other", "home");
const { Content } = await renderContent(home);
---

<BaseLayout
  displayTitle="Kristoffer Balintona — Personal site"
  pageTitle="Home"
  pageDescription="A personal site to help me flesh out my ideas and share them along the way"
>
  <article>
    <section>
      {Content && <Content />}
      <p>You may use these pages as entrypoints to my content:</p>
      <dl>
        <dt><Link to="/site-index">Index</Link></dt>
        <dd>
          {(await getContentEntry("other", "index"))?.data.description}
        </dd>
        <dt><Link to="/articles">Articles</Link></dt>
        <dd>
          {
            (await getContentEntry("other", "taxonomyArticles"))?.data
              .description
          }
        </dd>
        <dt><Link to="/notes">Notes</Link></dt>
        <dd>
          {(await getContentEntry("other", "taxonomyNotes"))?.data.description}
        </dd>
        <dt><Link to="/explore">Explore</Link></dt>
        <dd>
          {(await getContentEntry("other", "explore"))?.data.description}
        </dd>
      </dl>
      <p>
        Learn more about me and this site <Link to="/about">here</Link>.
        Licensing information may be found <Link to="/license">here</Link>. RSS
        feeds are also available for various subsets of my content; they are
        listed <Link to="/feeds">here</Link>.
      </p>
    </section>
    <section aria-labelledby="recents-heading">
      <Heading id="recents-heading" level="2">Recent</Heading>
      <PostListingCompact limit={10} showType={true} />
    </section>
  </article>
</BaseLayout>

<style>
  #recents-heading {
    margin-top: 0.1em;
  }

  :global(section + section) {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>

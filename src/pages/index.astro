---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentEntry, renderContent } from "@lib/entries";

const home = await getContentEntry("standalone", "about");
const { Content } = await renderContent(home);
---

<BaseLayout
  displayTitle="Kristoffer Balintona — Personal site"
  pageTitle="Home"
  pageDescription="A personal site to help me flesh out my ideas and share them along the way"
>
  {
    Content && (
      <article>
        <Content />
      </article>
    )
  }
</BaseLayout>

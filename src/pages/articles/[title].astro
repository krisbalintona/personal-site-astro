---
import ExpressionLayout from "@layouts/ExpressionLayout.astro";
import { getContentCollection, titleToUrlSlug } from "@lib/entries";
import { type CollectionEntry } from "astro:content";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/articles/[title]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getContentCollection("articles")).map((articleEntry) => ({
    params: { title: titleToUrlSlug(articleEntry.data.title) },
    props: { articleEntry },
  })),
);

interface Props {
  articleEntry: CollectionEntry<"articles">;
}

const { articleEntry } = Astro.props;
---

<ExpressionLayout expression={articleEntry} />

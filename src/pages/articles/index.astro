---
import Heading from "@components/markup/Heading.astro";
import PostListing from "@components/PostListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Articles">
  <Heading class="sr-only" level="1">Articles</Heading>
  <p>All my articles:</p>
  <hr>

  <PostListing collection="articles" />
</BaseLayout>

<style is:global lang="scss">
  @use "mixins";

  .article-listing {
    @include mixins.breakout(var(--space-s-m));
  }
</style>

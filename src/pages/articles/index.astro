---
import { getEntry, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "prose", href: $path({ to: "/prose" }) },
  { label: "Articles", styleNormal: true },
];

const articlesEntry = await getEntry("standalone", "taxonomyArticles");
const { Content: ArticlesContent } = articlesEntry
  ? await render(articlesEntry)
  : { Content: undefined };
---

<BaseLayout pageTitle="Articles" displayTitle="All articles">
  <Breadcrumb
    breadcrumbs={breadcrumbs}
    description={articlesEntry?.data.description}
  />
  {ArticlesContent && <ArticlesContent />}
  <hr>
  <ExpressionListing collections={["articles"]} />
</BaseLayout>

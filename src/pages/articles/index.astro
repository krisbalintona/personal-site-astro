---
import ArticleListing from "@components/ArticleListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Articles">
  All my articles:

  <ArticleListing />
</BaseLayout>

<style is:global lang="scss">
  @use "mixins";

  .article-listing {
    @include mixins.breakout(var(--space-s-m));
  }
</style>

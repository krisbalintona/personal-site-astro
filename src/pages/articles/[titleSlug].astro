---
import { type CollectionEntry, getCollection } from "astro:content";
import ExpressionLayout from "@layouts/ExpressionLayout.astro";
import { isPublished } from "@lib/entries";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/articles/[titleSlug]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getCollection("articles", isPublished)).map((article) => ({
    params: { titleSlug: article.data.titleSlug },
    props: { article },
  }))
);

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
---

<ExpressionLayout expression={article}></ExpressionLayout>

---
import { type CollectionEntry, getCollection } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
import isPublished from "@src/lib/isPublished";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/articles/[titleSlug]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getCollection("articles", isPublished)).map((article) => ({
    params: { titleSlug: article.data.titleSlug },
    props: { article },
  }))
);

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
---

<PostLayout post={article}></PostLayout>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import TaxonomyListingLayout from "@layouts/TaxonomyListingLayout.astro";
import { getContentCollection } from "@lib/entries";
import type { ExpressionEntry } from "@lib/expressions";
import { type CollectionEntry } from "astro:content";
import { createRoute } from "astro-typesafe-routes/create-route";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

export const Route = createRoute({
  routeId: "/threads/[thread]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getContentCollection("threads")).map((thread) => ({
    params: { thread: slugify(thread.data.title) },
    props: { thread },
  })),
);

interface Props {
  thread: CollectionEntry<"threads">;
}

const { thread: threadEntry } = Astro.props;
const threadTitle: string = threadEntry.data.title;

function hasThisThread(expression: ExpressionEntry): boolean {
  return expression.data.threads?.some((t) => t.id === threadEntry.id) ?? false;
}

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "explore", href: $path({ to: "/explore" }) },
  { label: "threads", href: $path({ to: "/threads" }) },
  { label: threadTitle, styleNormal: true },
];
---

<TaxonomyListingLayout
  pageTitle={threadTitle}
  displayTitle={`Entries belonging to the thread "${threadTitle}"`}
  breadcrumbs={breadcrumbs}
  rssHref={$path({
    to: "/threads/[thread]/feed.xml",
    params: { thread: slugify(threadTitle) },
    trailingSlash: false,
  })}
  breadcrumbsDescription={threadEntry?.data.description}
  preambleEntry={threadEntry}
>
  <ExpressionListing filter={hasThisThread} />
</TaxonomyListingLayout>

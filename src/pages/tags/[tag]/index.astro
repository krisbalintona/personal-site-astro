---
import { getEntry, render } from "astro:content";
import ArticleListing from "@components/ArticleListing.astro";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAllTags } from "@lib/getTags";
import type { AnyPost } from "@src/content.config";
import { createRoute } from "astro-typesafe-routes/create-route";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

export const Route = createRoute({
  routeId: "/tags/[tag]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getAllTags()).map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag },
  }))
);

interface Props {
  tag: string;
}

const { tag } = Astro.props;

function hasThisTag(entry: AnyPost): boolean {
  const entryTags: string[] = entry.data.tags ?? [];

  return entryTags.includes(tag);
}

const tagEntry = await getEntry("tags", tag);
const { Content } = tagEntry ? await render(tagEntry) : { Content: null };

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "tags", href: $path({ to: "/tags" }) },
  { label: tag, styleNormal: true },
];
---

<BaseLayout pageTitle={tag}>
  <Breadcrumb breadcrumbs={breadcrumbs} />

  {Content && <article><Content /></article>}

  <ArticleListing extraFilter={hasThisTag} />
</BaseLayout>

<style>
  article {
    margin-top: 50px;
  }
</style>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import TaxonomyListingLayout from "@layouts/TaxonomyListingLayout.astro";
import { getContentCollection } from "@lib/entries";
import type { ExpressionEntry } from "@lib/expressions";
import { type CollectionEntry } from "astro:content";
import { createRoute } from "astro-typesafe-routes/create-route";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

export const Route = createRoute({
  routeId: "/tags/[tag]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getContentCollection("tags")).map((tag) => ({
    params: { tag: slugify(tag.data.title) },
    props: { tag },
  })),
);

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag: tagEntry } = Astro.props;
const tagTitle = tagEntry.data.title;

function hasThisTag(expression: ExpressionEntry): boolean {
  return expression.data.tags?.some((t) => t.id === tagEntry.id) ?? false;
}

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "explore", href: $path({ to: "/explore" }) },
  { label: "tags", href: $path({ to: "/tags" }) },
  { label: tagTitle, styleNormal: true },
];
---

<TaxonomyListingLayout
  pageTitle={tagTitle}
  displayTitle={`Entries tagged with "${tagTitle}"`}
  breadcrumbs={breadcrumbs}
  rssHref={$path({
    to: "/tags/[tag]/feed.xml",
    params: { tag: slugify(tagTitle) },
    trailingSlash: false,
  })}
  breadcrumbsDescription={tagEntry?.data.description}
  preambleEntry={tagEntry}
>
  <ExpressionListing filter={hasThisTag} />
</TaxonomyListingLayout>

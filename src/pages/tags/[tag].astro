---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import Heading from "@components/markup/Heading.astro";
import PostListing from "@components/PostListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { PostEntry } from "@lib/posts";
import { createRoute } from "astro-typesafe-routes/create-route";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

export const Route = createRoute({
  routeId: "/tags/[tag]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getCollection("tags")).map((tag) => ({
    params: { tag: slugify(tag.data.name) },
    props: { tag },
  }))
);

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag } = Astro.props;
const tagName = tag.data.name;

function hasThisTag(entry: PostEntry): boolean {
  const entryTags: string[] = entry.data.tags ?? [];

  return entryTags.includes(tagName);
}

const tagEntry = (await getCollection("tags")).find(
  (e) => e.data.name === tag.data.name
);
const { Content } = tagEntry ? await render(tagEntry) : { Content: null };

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "tags", href: $path({ to: "/tags" }) },
  { label: tagName, styleNormal: true },
];
---

<BaseLayout pageTitle={tagName}>
  <Heading class="sr-only" level="1">Posts tagged with "{tagName}"</Heading>
  <Breadcrumb breadcrumbs={breadcrumbs} />
  {Content && <Content />}
  <hr>

  <PostListing collection="articles" extraFilter={hasThisTag} />
</BaseLayout>

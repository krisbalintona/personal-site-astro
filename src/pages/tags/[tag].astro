---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import type { ExpressionEntry } from "@src/lib/expressions";
import { createRoute } from "astro-typesafe-routes/create-route";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

export const Route = createRoute({
  routeId: "/tags/[tag]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getCollection("tags")).map((tag) => ({
    params: { tag: slugify(tag.data.title) },
    props: { tag },
  }))
);

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag: tagEntry } = Astro.props;
const tagName = tagEntry.data.title;

function hasThisTag(expression: ExpressionEntry): boolean {
  return expression.data.tags?.some((t) => t.id === tagEntry.id) ?? false;
}

const { Content } = tagEntry ? await render(tagEntry) : { Content: null };

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "tags", href: $path({ to: "/tags" }) },
  { label: tagName, styleNormal: true },
];
---

<BaseLayout
  pageTitle={tagName}
  displayTitle={`Entries tagged with "${tagName}"`}
>
  <Breadcrumb breadcrumbs={breadcrumbs} />
  {tagEntry && isPublished(tagEntry) && Content && <Content />}
  <hr>

  <ExpressionListing
    collections={["articles", "notes"]}
    extraFilter={hasThisTag}
  />
</BaseLayout>

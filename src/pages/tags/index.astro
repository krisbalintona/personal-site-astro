---
import { getEntry, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import TaxonomyListingCompact from "@components/TaxonomyListingCompact.astro";
import { isPublished } from "@lib/entries";
import { allExpressions } from "@lib/expressions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import { $path } from "astro-typesafe-routes/path";

const tagCounts: Map<string, number> = new Map();
const expressions = await allExpressions(isPublished);
for (const expression of expressions) {
  for (const tag of expression.data.tags ?? []) {
    tagCounts.set(tag.id, (tagCounts.get(tag.id) ?? 0) + 1);
  }
}

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "explore", href: $path({ to: "/explore" }) },
  { label: "Tags", styleNormal: true },
];

const tagsEntry = await getEntry("standalone", "taxonomyTags");
const { Content: TagsContent } = tagsEntry
  ? await render(tagsEntry)
  : { Content: undefined };
---

<BaseLayout pageTitle="Tags" displayTitle="All tags">
  <Breadcrumb
    breadcrumbs={breadcrumbs}
    description={tagsEntry?.data.description}
  />
  {TagsContent && <TagsContent />}
  <hr>
  <TaxonomyListingCompact collections={["tags"]} sortBy="title" />
</BaseLayout>

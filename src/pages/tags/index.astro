---
import { type CollectionEntry, getCollection } from "astro:content";
import { isPublished } from "@lib/entries";
import { allExpressions } from "@lib/expressions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import Link from "astro-typesafe-routes/link";
import slugify from "slugify";

const tags = await getCollection("tags");
const tagsOrdered: CollectionEntry<"tags">[] = tags?.sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const tagCounts: Map<string, number> = new Map();
const expressions = await allExpressions(isPublished);

for (const expression of expressions) {
  for (const tag of expression.data.tags ?? []) {
    tagCounts.set(tag.id, (tagCounts.get(tag.id) ?? 0) + 1);
  }
}
---

<BaseLayout pageTitle="Tags" displayTitle="Tags">
  {tags.length > 0 && (
    <ul>
      {tagsOrdered.map((tag) => {
        const count = tagCounts.get(tag.id) ?? 0;

        return (
          <li>
            <Link params={{ tag: slugify(tag.data.title) }} to="/tags/[tag]"
            >{tag.data.title}</Link>, {count} {count === 1 ? "entry" : "entries"}
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import Heading from "@components/markup/Heading.astro";
import TaxonomyListingCompact from "@components/TaxonomyListingCompact.astro";
import TaxonomyListingLayout from "@layouts/TaxonomyListingLayout.astro";
import { getContentEntry, renderContent } from "@lib/entries";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "Explore", styleNormal: true },
  [
    { label: "tags", href: $path({ to: "/tags" }) },
    { label: "threads", href: $path({ to: "/threads" }) },
  ],
];

const exploreEntry = await getContentEntry("standalone", "explore");
const { Content: TagsContent } = await renderContent(
  await getContentEntry("standalone", "taxonomyTags"),
);
const { Content: ThreadsContent } = await renderContent(
  await getContentEntry("standalone", "taxonomyThreads"),
);
---

<TaxonomyListingLayout
  pageTitle="Explore"
  displayTitle="Explore"
  breadcrumbs={breadcrumbs}
  breadcrumbsDescription={exploreEntry?.data.description}
  preambleEntry={exploreEntry}
>
  <section aria-labelledby="tags-heading">
    <Heading id="tags-heading" level="2"><Link to="/tags">Tags</Link></Heading>
    {TagsContent && <TagsContent />}
    <TaxonomyListingCompact
      moreLink={$path({ to: "/tags" })}
      collections={["tags"]}
      limit={8}
      sortBy="count"
    />
  </section>
  <section aria-labelledby="threads-heading">
    <Heading id="threads-heading" level="2"
      ><Link to="/threads">Threads</Link></Heading
    >
    {ThreadsContent && <ThreadsContent />}
    <TaxonomyListingCompact
      moreLink={$path({ to: "/threads" })}
      collections={["threads"]}
      limit={8}
      sortBy="title"
    />
  </section>
</TaxonomyListingLayout>

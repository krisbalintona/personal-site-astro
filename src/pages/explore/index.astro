---
import { getCollection } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import Heading from "@components/markup/Heading.astro";
import TaxonomyListingCompact from "@components/TaxonomyListingCompact.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "Explore", styleNormal: true },
  [
    { label: "tags", href: $path({ to: "/tags" }) },
    { label: "threads", href: $path({ to: "/threads" }) },
  ],
];
---

<BaseLayout pageTitle="Explore" displayTitle="Explore">
  <Breadcrumb breadcrumbs={breadcrumbs} />
  <section aria-labelledby="tags-heading">
    <Heading id="tags-heading" level="2"><Link to="/tags">Tags</Link></Heading>
    <TaxonomyListingCompact
      browseAllLink={$path({ to: "/tags" })}
      collections={["tags"]}
      limit={8}
      sortBy="count"
    />
  </section>
  <hr>
  <section aria-labelledby="threads-heading">
    <Heading id="threads-heading" level="2"
      ><Link to="/threads">Threads</Link></Heading
    >
    <TaxonomyListingCompact
      browseAllLink={$path({ to: "/threads" })}
      collections={["threads"]}
      limit={8}
      sortBy="title"
    />
  </section>
</BaseLayout>

---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Heading from "@components/markup/Heading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import type { PostEntry } from "@lib/posts";
import PostListingCompact from "@src/components/PostListingCompact.astro";
import slugify from "slugify";

const allThreadEntries = await getCollection("threads");

function inThisThread(thread: CollectionEntry<"threads">) {
  return (post: PostEntry): boolean =>
    post.data.threads?.some((s) => s.id === thread.id) ?? false;
}
---

<BaseLayout pageTitle="Explore" displayTitle="Explore">
  <Heading id="threads" class="subdivision-heading" level="2" selfLink={true}
    >Threads</Heading
  >
  {allThreadEntries.map(async (s) => {
     const thread = (await getCollection("threads")).find((e) => e.data.name === s.data.name);
     const { Content } = thread ? await render(thread) : { Content: null };

     return (
       <section>
         <Heading
           id={slugify(s.data.name, { lower: true, strict: true})}
           level="3"
           selfLink={true}
         >{s.data.name}</Heading>
         {thread && isPublished(thread) && Content && <Content />}
         
         <div class="listing-container">
           <PostListingCompact
             collection="articles"
             descending={false}
             extraFilter={inThisThread(s)} />
         </div>
       </section>
       )})}
</BaseLayout>

<style>
  .subdivision-heading {
    text-align: center;
  }

  .listing.container {
    padding: 0 var(--space-m) 0 var(--space-m);
  }
</style>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContentEntry, renderContent } from "@lib/entries";
import { getRssFeedUrl, RSSFeeds } from "@lib/rss";
import Link from "astro-typesafe-routes/link";

const preamble = await getContentEntry("standalone", "rss_feeds");
const { Content: PreambleContent } = await renderContent(preamble);
---

<BaseLayout pageTitle="RSS" displayTitle="RSS feeds">
  {PreambleContent && <PreambleContent />}

  {
    RSSFeeds && (
      <dl>
        {Object.entries(RSSFeeds).map(([feedName, channel]) => {
          return (
            <>
              <dt>
                <a href={getRssFeedUrl(feedName)}>{feedName}</a>
              </dt>
              <dd>{channel.description}</dd>
            </>
          );
        })}
      </dl>
    )
  }
  <p>
    Additionally, <Link to="/tags">each tag</Link> and <Link to="/threads"
      >each thread</Link
    > has its own associated feed.
  </p>
</BaseLayout>

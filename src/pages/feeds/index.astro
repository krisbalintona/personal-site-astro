---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getRSSFeedUrl, topLevelRSSFeeds } from "@lib/rss";
import Link from "astro-typesafe-routes/link";

const feeds = await topLevelRSSFeeds();
---

<BaseLayout
  displayTitle="RSS feeds"
  pageTitle="RSS"
  pageDescription="Learn about where my site's RSS feeds can be found"
>
  <p>This site offers multiple RSS feeds for its content:</p>
  {
    feeds && (
      <dl>
        {Object.entries(feeds).map(([feedName, channel]) => {
          return (
            <>
              <dt>
                <a href={getRSSFeedUrl(feedName)}>{feedName}</a>
              </dt>
              <dd>{channel.description}</dd>
            </>
          );
        })}
      </dl>
    )
  }
  <p>
    Additionally, <Link to="/tags">each tag</Link> and <Link to="/threads"
      >each thread</Link
    > has its own associated feed (look out for the feed icon near the top of each
    page).
  </p>
</BaseLayout>

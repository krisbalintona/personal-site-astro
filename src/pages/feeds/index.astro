---
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import { RSSFeeds } from "@lib/rss";
import Link from "astro-typesafe-routes/link";

const preamble = await getEntry("standalone", "rss_feeds");
const { Content } = preamble ? await render(preamble) : { Content: null };
---

<BaseLayout pageTitle="RSS" displayTitle="RSS feeds">
  {preamble && isPublished(preamble) && Content && <Content />}

  {RSSFeeds &&
  <dl>
    {Object.entries(RSSFeeds).map(([feedName, channel]) => {
      const feedTitle = String(feedName)[0].toUpperCase() + String(feedName).slice(1);
      return (
        <>
          <dt>
            {/* Explicitly set `trailingSlash={false}` because the
            actual built file paths are e.g. `dist/feeds/all.xml` with
            no trailing slash. The mismatch would cause false
            positives in astro-broken-links-checker. */}
            <Link
              params={{ feed: feedName }}
              to="/feeds/[feed].xml"
              trailingSlash={false}
            >{feedTitle}</Link>
          </dt>
          <dd>{channel.description}</dd>
        </>
      );
    })}
  </dl>}
</BaseLayout>

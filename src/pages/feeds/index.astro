---
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import { getRssFeedUrl, RSSFeeds } from "@lib/rss";
import { getEntry, render } from "astro:content";

const preamble = await getEntry("standalone", "rss_feeds");
const { Content } = preamble ? await render(preamble) : { Content: undefined };
---

<BaseLayout pageTitle="RSS" displayTitle="RSS feeds">
  {preamble && isPublished(preamble) && Content && <Content />}

  {
    RSSFeeds && (
      <dl>
        {Object.entries(RSSFeeds).map(([feedName, channel]) => {
          return (
            <>
              <dt>
                <a href={getRssFeedUrl(feedName)}>{feedName}</a>
              </dt>
              <dd>{channel.description}</dd>
            </>
          );
        })}
      </dl>
    )
  }
</BaseLayout>

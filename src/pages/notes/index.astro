---
import ExpressionListing from "@components/ExpressionListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Notes" displayTitle="All notes">
  <p>All notes:</p>
  <hr>

  <ExpressionListing collections={["notes"]} />
</BaseLayout>

<style is:global lang="scss">
  @use "mixins";

  .expression-listing {
    @include mixins.breakout(var(--space-s-m));
  }
</style>

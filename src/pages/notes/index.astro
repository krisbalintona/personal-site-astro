---
import { getEntry, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "prose", href: $path({ to: "/prose" }) },
  { label: "Notes", styleNormal: true },
];

const notesEntry = await getEntry("standalone", "taxonomyNotes");
const { Content: NotesContent } = notesEntry
  ? await render(notesEntry)
  : { Content: undefined };
---

<BaseLayout pageTitle="Notes" displayTitle="All notes">
  <Breadcrumb
    breadcrumbs={breadcrumbs}
    description={notesEntry?.data.description}
  />
  {NotesContent && <NotesContent />}
  <hr>
  <ExpressionListing collections={["notes"]} />
</BaseLayout>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import ExpressionListing from "@components/ExpressionListing.astro";
import TaxonomyListingLayout from "@layouts/TaxonomyListingLayout.astro";
import { getEntry } from "astro:content";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "prose", href: $path({ to: "/prose" }) },
  { label: "Notes", styleNormal: true },
];

const notesEntry = await getEntry("standalone", "taxonomyNotes");
---

<TaxonomyListingLayout
  pageTitle="Notes"
  displayTitle="All notes"
  breadcrumbs={breadcrumbs}
  breadcrumbsDescription={notesEntry?.data.description}
  preambleEntry={notesEntry}
>
  <ExpressionListing collections={["notes"]} />
</TaxonomyListingLayout>

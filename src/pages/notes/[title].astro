---
import ExpressionLayout from "@layouts/ExpressionLayout.astro";
import { getContentCollection, titleToUrlSlug } from "@lib/entries";
import { type CollectionEntry } from "astro:content";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/notes/[title]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getContentCollection("notes")).map((noteEntry) => ({
    params: { title: titleToUrlSlug(noteEntry.data.title) },
    props: { noteEntry },
  })),
);

interface Props {
  noteEntry: CollectionEntry<"notes">;
}

const { noteEntry } = Astro.props;
---

<ExpressionLayout expression={noteEntry} />

---
import { type CollectionEntry, getCollection } from "astro:content";
import ExpressionLayout from "@layouts/ExpressionLayout.astro";
import { isPublished } from "@lib/entries";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/notes/[titleSlug]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () =>
  (await getCollection("notes", isPublished)).map((noteEntry) => ({
    params: { titleSlug: noteEntry.data.titleSlug },
    props: { noteEntry },
  }))
);

interface Props {
  noteEntry: CollectionEntry<"notes">;
}

const { noteEntry } = Astro.props;
---

<ExpressionLayout expression={noteEntry}></ExpressionLayout>

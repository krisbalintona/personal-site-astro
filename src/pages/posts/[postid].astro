---
import { getCollection } from "astro:content";
import type { PostEntry } from "@lib/posts";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/posts/[postid]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () => {
  // Currently, only posts that aren't drafts get a permalink
  const allPosts = (
    await Promise.all([
      getCollection("articles", (entry) => entry.data.draft === false),
    ])
  ).flat();

  return allPosts.map((post) => ({
    params: { postid: post.id },
    props: { post },
  }));
});

interface Props {
  post: PostEntry;
}

// NOTE 2026-04-19: I prefix the variable with an underscore because
// `astro check` will complain that `post` is unused, despite it being
// used in the redirect below. // I think the relevant bug report is:
// https://github.com/withastro/astro/issues/14684.
const { post: _post } = Astro.props;
return Route.redirect(Astro, {
  to: `/${_post.collection}/[slug]`,
  params: { slug: _post.data.slug },
});
---


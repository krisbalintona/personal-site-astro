---
import { getEntryUrl } from "@lib/entries";
import { allPosts, getPostLegacyId, getPostStableId } from "@lib/posts.ts";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/posts/[stableId]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () => {
  const posts = await allPosts();
  return posts.flatMap((e) => {
    const targetUrl = getEntryUrl(e);
    const paths = [
      {
        params: { stableId: getPostStableId(e) },
        props: { targetUrl },
      },
    ];
    // Also register the legacy Hugo local-time ID if present, so old
    // Hugo permalinks (e.g., /posts/202504201934) continue to
    // redirect correctly alongside the UTC-based stable ID (e.g,
    // /posts/202504210034)
    const legacyId = getPostLegacyId(e);
    if (legacyId) {
      paths.push({
        params: { stableId: legacyId },
        props: { targetUrl },
      });
    }
    return paths;
  });
});

// `targetUrl` is used in the return statement below, but `astro
// check` cannot trace through it and incorrectly reports them as unused.
// So, as a trick, we prefix the symbol name with an underscore.
const { targetUrl: _targetUrl } = Astro.props;
return Astro.redirect(_targetUrl, 301);
---

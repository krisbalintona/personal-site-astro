---
import { getContentCollection, getEntryUrl } from "@lib/entries";
import { allPosts } from "@lib/posts";
import { createRoute } from "astro-typesafe-routes/create-route";

export const Route = createRoute({
  routeId: "/[...redirect]",
});

export const getStaticPaths = Route.createGetStaticPaths(async () => {
  const entries = (
    await Promise.all([allPosts(), await getContentCollection("standalone")])
  ).flat();

  return entries.flatMap((entry) => {
    if (!entry.data.redirects?.length) return [];
    return entry.data.redirects.map((redirectPath) => ({
      params: {
        redirect: redirectPath.slice(1), // Strip leading slash
      },
      props: {
        targetUrl: getEntryUrl(entry),
      },
    }));
  });
});

// `targetUrl` is used in the return statement below, but `astro
// check` cannot trace through it and incorrectly reports them as unused.
// So, as a trick, we prefix the symbol name with an underscore.
const { targetUrl: _targetUrl } = Astro.props;
return Astro.redirect(_targetUrl, 301);
---

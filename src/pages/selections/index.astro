---
import { getEntry, render } from "astro:content";
import PostListing from "@components/PostListing.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";

const preamble = await getEntry("standalone", "selections");
const { Content } = preamble ? await render(preamble) : { Content: null };
---

<BaseLayout pageTitle="Selections">
  {preamble && isPublished(preamble) && Content && <section><Content /></section>}

  <PostListing collection="articles" />
</BaseLayout>

---
import { getCollection, getEntry, render } from "astro:content";
import Heading from "@components/markup/Heading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import type { PostEntry } from "@lib/posts";
import PostListingCompact from "@src/components/PostListingCompact.astro";
import slugify from "slugify";

const preamble = await getEntry("standalone", "selections");
const { Content } = preamble ? await render(preamble) : { Content: null };

const allSeries = await getCollection("series");

function inThisSeries(seriesName: string) {
  return (entry: PostEntry): boolean => {
    const entrySeries: string[] = entry.data.series ?? [];
    return entrySeries.includes(seriesName);
  };
}
---

<BaseLayout pageTitle="Selections" displayTitle="Selections">
  {preamble && isPublished(preamble) && Content && <Content />}
  <hr>

  <Heading id="series" class="subdivision-heading" level="2" selfLink={true}
    >Series</Heading
  >
  {allSeries.map(async (s) => {
     const seriesEntry = (await getCollection("series")).find((e) => e.data.name === s.data.name);
     const { Content } = seriesEntry ? await render(seriesEntry) : { Content: null };

     return (
       <section>
         <Heading
           id={slugify(s.data.name, { lower: true, strict: true})}
           level="3"
           selfLink={true}
         >{s.data.name}</Heading>
         {seriesEntry && isPublished(seriesEntry) && Content && <Content />}
         
         <div class="listing-container">
           <PostListingCompact
             collection="articles"
             descending={false}
             extraFilter={inThisSeries(s.data.name)} />
         </div>
       </section>
       )})}
</BaseLayout>

<style>
  .subdivision-heading {
    text-align: center;
  }

  .listing.container {
    padding: 0 var(--space-m) 0 var(--space-m);
  }
</style>

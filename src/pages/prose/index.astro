---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import ExpressionListingCompact from "@components/ExpressionListingCompact.astro";
import Heading from "@components/markup/Heading.astro";
import TaxonomyListingLayout from "@layouts/TaxonomyListingLayout.astro";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "Prose", styleNormal: true },
  [
    { label: "articles", href: $path({ to: "/articles" }) },
    { label: "notes", href: $path({ to: "/notes" }) },
  ],
];
---

<TaxonomyListingLayout
  pageTitle="Prose"
  displayTitle="Prose"
  breadcrumbs={breadcrumbs}
>
  <section aria-labelledby="articles-heading">
    <Heading id="articles-heading" level="2"
      ><Link to="/articles">Articles</Link></Heading
    >
    <p>Essays and long-form writing</p>
    <ExpressionListingCompact
      browseAllLink={$path({ to: "/articles" })}
      collections={["articles"]}
      limit={5}
    />
  </section>
  <section aria-labelledby="notes-heading">
    <Heading id="notes-heading" level="2"
      ><Link to="/notes">Notes</Link></Heading
    >
    <p>Unrefined reflections and ongoing thinking</p>
    <ExpressionListingCompact
      browseAllLink={$path({ to: "/notes" })}
      collections={["notes"]}
      limit={5}
    />
  </section>
</TaxonomyListingLayout>

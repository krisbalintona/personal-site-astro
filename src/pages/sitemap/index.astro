        <li><Link to="/articles">Articles</Link></li>
        <li><Link to="/notes">Notes</Link></li>
      </ul>
    </li>
    <li>
      <Link to="/explore">Explore</Link>
      <ul>
        <li><Link to="/tags">Tags</Link></li>
        <li><Link to="/threads">Threads</Link></li>
      </ul>
    </li>
  </ul>
</BaseLayout>

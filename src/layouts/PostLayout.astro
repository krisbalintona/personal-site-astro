---
import { render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { PostEntry } from "@lib/posts";
import { toDateTimeAttribute } from "@src/lib/date";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;

const pubDate = post.data.pubDate;
const title = post.data.title;

const breadcrumbs: BreadcrumbComponent[] = [
  { label: post.collection, href: $path({ to: `/${post.collection}` }) },
];

const formattedDateTime = toDateTimeAttribute(pubDate);
const formattedVisibleDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const tags = post.data.tags;
const { Content } = await render(post);
---

<BaseLayout pageTitle={title}>
  <article>
    <header class="post-header">
      <Breadcrumb breadcrumbs={breadcrumbs} />

      <div class="post-info-container">
        <time class="post-date" datetime={formattedDateTime}
          >{formattedVisibleDate}</time
        >

        <h1 id="post-title">{title}</h1>
      </div>
    </header>

    <div class="post-content"><Content /></div>

    <footer class="post-footer">
      <div class="post-tags-container">
        {tags && <span id="tags-label">tagged: </span>}
        {tags?.map((tag, i) =>
        <>{i > 0 && ", "}
          <Link class="tag" params={{ tag: slugify(tag) }} to="/tags/[tag]">{tag}</Link>
        </>
      )}
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-border);

    .post-info-container {
      .post-date {
        display: block;
        margin: var(--space-3xs-2xs) 0;
        font-family: var(--font-ui);
        font-size: var(--font-step--1);
      }

      #post-title {
        margin: 0 0 var(--space-s) 0;
      }
    }
  }

  .post-content {
    margin-top: var(--space-l);
  }

  /* "Breakout" effect for code blocks, standalone images, and figures */
  @layer defaults {
    :where(.post-content) {
      .expressive-code {
        --breakout: 1rem;
        width: calc(100% + var(--breakout) * 2);
        max-width: calc(100% + var(--breakout) * 2);
        margin-left: calc(-1 * var(--breakout));
      }

      figure,
      img {
        --breakout: 2rem;
        width: calc(100% + var(--breakout) * 2);
        max-width: calc(100% + var(--breakout) * 2);
        margin-left: calc(-1 * var(--breakout));
      }

      /* For images in figures: images fill their container and */
      /* the container itself has the bleed effect */
      figure img {
        width: 100%;
        max-width: 100%;
        margin-left: 0;
      }
    }
  }

  .post-footer {
    margin-top: var(--space-xs-s);
    border-top: 2px solid var(--color-border);

    .post-tags-container {
      display: inline;
      font-size: var(--font-step--1);

      #tags-label {
        font-weight: bold;
      }

      .tag {
        font-style: italic;
        color: var(--color-text-secondary);
        border-bottom: 0;
        transition: color 0.15s;
      }

      .tag:hover {
        color: var(--color-text);
      }
    }
  }
</style>

---
import { render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { AnyPost } from "@src/content.config";
import slugify from "slugify";

interface Props {
  post: AnyPost;
}

const { post } = Astro.props;

const date = post.data.date;
const title = post.data.title;

const breadcrumbs: BreadcrumbComponent[] = [
  { label: post.collection, href: `/${slugify(post.collection)}` },
];

const formattedDateTime = date.toISOString().replace(/\.\d{3}Z$/, () => {
  const offset = -date.getTimezoneOffset();
  const pad = (n: number) => String(n).padStart(2, "0");
  return (
    (offset >= 0 ? "+" : "-") +
    pad(Math.floor(Math.abs(offset) / 60)) +
    ":" +
    pad(Math.abs(offset) % 60)
  );
});
const formattedVisibleDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const tags = post.data.tags;
const { Content } = await render(post);
---

<BaseLayout pageTitle={title}>
  <article>
    <header>
      <Breadcrumb breadcrumbs={breadcrumbs} />

      <div id="post-info-container">
        <time datetime={formattedDateTime}
          ><span id="post-date">{formattedVisibleDate}</span></time
        >

        <h1>{title}</h1>
      </div>
      <hr>
    </header>

    <Content />

    <footer id="post-footer">
      <hr>
      <div id="post-tags-container">
        {tags && <b><span>tagged:</span></b>}
        {tags?.map((tag, i) =>
        <>{i > 0 && ", "}<span><a href={`/tags/${slugify(tag)}`}>{tag}</a></span></>
      )}
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  #post-info-container h1 {
    margin-top: 0;
  }

  #post-date {
    font-size: smaller;
    font-style: italic;
  }

  #post-tags-container {
    font-size: smaller;

    span {
      font-style: italic;
    }
  }
</style>

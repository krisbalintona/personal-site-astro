---
import { render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { PostEntry } from "@lib/posts";
import { toDateTimeAttribute } from "@src/lib/date";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;

const pubDate = post.data.pubDate;
const title = post.data.title;

const breadcrumbs: BreadcrumbComponent[] = [
  { label: post.collection, href: $path({ to: `/${post.collection}` }) },
];

const formattedDateTime = toDateTimeAttribute(pubDate);
const formattedVisibleDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const tags = post.data.tags;
const { Content } = await render(post);
---

<BaseLayout pageTitle={title}>
  <article>
    <header class="post-header">
      <Breadcrumb breadcrumbs={breadcrumbs} />

      <div class="post-info-container">
        <time datetime={formattedDateTime}
          ><span class="post-date">{formattedVisibleDate}</span></time
        >

        <h1 id="post-title">{title}</h1>
      </div>
    </header>

    <div class="post-content"><Content /></div>

    <footer class="post-footer">
      <div class="post-tags-container">
        {tags && <span id="tags-label">tagged: </span>}
        {tags?.map((tag, i) =>
        <>{i > 0 && ", "}
          <Link class="tag" params={{ tag: slugify(tag) }} to="/tags/[tag]">{tag}</Link>
        </>
      )}
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 3rem;
    border-bottom: 2px solid var(--rule);

    .post-info-container {
      .post-date {
        font-family: var(--font-ui);
        font-size: smaller;
      }

      #post-title {
        margin: 0 0 1rem 0;
        font-size: 3rem;
      }
    }
  }

  .post-content {
    margin-top: 2rem;

    :global(#table-of-contents) {
      font-size: 1.8rem;
    }

    img {
      --bleed: 2rem;
      width: calc(100% + var(--bleed) * 2);
      max-width: calc(100% + var(--bleed) * 2);
      margin-left: calc(-1 * var(--bleed));
    }
  }

  .post-footer {
    padding-top: 0.5rem;
    border-top: 2px solid var(--rule);

    .post-tags-container {
      display: inline;
      align-items: baseline;
      font-size: smaller;

      #tags-label {
        font-weight: bold;
      }

      .tag {
        font-style: italic;
        color: var(--muted);
        border-bottom: 0;
        transition: color 0.15s;
      }

      .tag:hover {
        color: var(--ink);
      }
    }
  }
</style>

---
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import PostTaxonomyRow from "@components/PostTaxonomyRow.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import {
  getContentEntries,
  getEntryUrl,
  toDateTimeAttribute,
} from "@lib/entries";
import { getPostPermalink, getPostStableId, type PostEntry } from "@lib/posts";
import { Icon } from "astro-icon/components";
import { $path } from "astro-typesafe-routes/path";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;

const title = post.data.title;
const pubDate = post.data.pubDate;
const lastMod = post.data.lastMod;

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "index", href: $path({ to: "/site-index" }) },
  {
    label: post.collection,
    href: $path({ to: `/${post.collection}` }),
  },
];

const dateStringFormat: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
// Publication date
const formattedPubDate = toDateTimeAttribute(pubDate);
const visiblePubDate = pubDate.toLocaleDateString("en-US", dateStringFormat);
// Last modification
let formattedLastMod;
let visibleLastMod;
if (lastMod) {
  formattedLastMod = toDateTimeAttribute(lastMod);
  visibleLastMod = lastMod.toLocaleDateString("en-US", dateStringFormat);
}

const tags = post.data.tags;
const threads = post.data.threads;
---

{
  /* Use permalink as path (for GoatCounter and OpenHeart reactions)
  to be robust against path changes. */
}
<ContentLayout
  entry={post}
  reactionsPath={getPostPermalink(post)}
  notAIBadge={true}
  goatCounterSettings={{
    path: $path({
      to: "/posts/[stableId]",
      params: { stableId: getPostStableId(post) },
    }),
  }}
>
  <Breadcrumb slot="header" breadcrumbs={breadcrumbs} />
  <div slot="header" class="post-info-meta">
    {
      lastMod ? (
        <>
          <time datetime={formattedPubDate}>{visiblePubDate}</time>
          <span class="sr-only">,</span>
          <span class="last-mod">
            last updated{" "}
            <time datetime={formattedLastMod}>{visibleLastMod}</time>
          </span>
        </>
      ) : (
        <time datetime={formattedPubDate}>{visiblePubDate}</time>
      )
    }
    <button
      id="copy-permalink"
      aria-label="Copy permalink"
      data-permalink={getPostPermalink(post)}
    >
      <Icon name="ph:link" aria-hidden="true" focusable="false" />
      <span class="copy-tooltip">Copied!</span>
    </button>
  </div>
  <Fragment slot="header">
    {
      post.data.subtitle ? (
        <hgroup class="post-title">
          <h1>{title}</h1>
          <p>{post.data.subtitle}</p>
        </hgroup>
      ) : (
        <h1 class="post-title">{title}</h1>
      )
    }
  </Fragment>

  <dl slot="footer" class="post-taxonomy">
    {
      tags && (
        <PostTaxonomyRow
          label="tagged"
          items={(await getContentEntries(tags)).map((tag) => ({
            href: getEntryUrl(tag),
            title: tag.data.title,
          }))}
        />
      )
    }
    {
      threads && (
        <PostTaxonomyRow
          label="in threads"
          items={(await getContentEntries(threads)).map((thread) => ({
            href: getEntryUrl(thread),
            title: thread.data.title,
          }))}
        />
      )
    }
  </dl>
</ContentLayout>

<style>
  .post-info-meta {
    font-size: var(--font-step--1);
    margin: var(--space-3xs) 0;

    .last-mod {
      font-size: small;
      color: var(--color-text-muted);
    }

    button#copy-permalink {
      display: inline-flex;
      align-items: center;
      padding: 0;
      cursor: pointer;
      background: none;
      border: none;
      font-size: 0.9em;
      position: relative;
      margin-left: var(--space-3xs);

      &:hover [data-icon] {
        color: var(--color-accent);
      }

      .copy-tooltip {
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        font-size: var(--font-step--2);
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s ease;
      }

      &.copied .copy-tooltip {
        opacity: 1;
      }
    }
  }

  .post-title {
    /* With and without subtitle */
    margin: 0 0 var(--space-s) 0;

    /* Only: with subtitle */
    h1 {
      margin-top: 0;
      margin-bottom: var(--space-3xs);
    }

    p {
      margin-top: 0;
      margin-bottom: var(--space-s);
    }
  }

  .post-taxonomy {
    margin: 0.5rem 0 var(--space-m) 0;
    padding: 0;
  }
</style>

<script>
  const btn = document.getElementById("copy-permalink");
  btn?.addEventListener("click", () => {
    const permalink = btn.getAttribute("data-permalink");
    if (permalink) {
      // Copy to clipboard
      navigator.clipboard.writeText(
        new URL(permalink, window.location.origin).href,
      );
      // Show brief tooltip
      btn.classList.add("copied");
      const originalAriaLabel = btn.getAttribute("aria-label");
      btn.setAttribute("aria-label", "Permalink copied!");
      setTimeout(() => {
        btn.classList.remove("copied");
        // Restore aria-label to ensure it is reset when the user
        // presses the button in quick succession
        btn.setAttribute("aria-label", originalAriaLabel ?? "Copy permalink");
      }, 2000);
    }
  });
</script>

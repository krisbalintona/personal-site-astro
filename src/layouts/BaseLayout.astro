---
import "@styles/vars.css";
import "@styles/global.css";

import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Heading from "@components/markup/Heading.astro";
import { SITE_TITLE } from "@lib/consts";
import { getRSSFeedUrl, RSSFeeds } from "@lib/rss";
import { Font } from "astro:assets";

interface Props {
  displayTitle?: string;
  pageTitle: string;
}

const { pageTitle, displayTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${pageTitle} - ${SITE_TITLE}`}</title>

    {/* Adaptive-color favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Astro fonts */}
    <Font cssVariable="--font-primary" />
    <Font cssVariable="--font-ui" />
    <Font cssVariable="--font-code" />

    {/* astrojs/sitemap */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      /* RSS autodiscovery. See
    https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery
    for more information */
    }
    {
      Object.entries(await RSSFeeds()).map(([feedName, channel]) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={channel.title}
          href={getRSSFeedUrl(feedName)}
        />
      ))
    }
  </head>

  <body>
    <Header />
    <div class="page-content">
      <main>
        {
          displayTitle && (
            <Heading class="sr-only" level="1">
              {displayTitle}
            </Heading>
          )
        }
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  body {
    --page-side-padding: var(--space-s-m);

    padding: 0 var(--page-side-padding);

    .page-content {
      max-width: 70ch;
      margin: var(--space-xs-s) auto 0;
    }
  }
</style>

---
import "@styles/vars.css";
import "@styles/global.css";

import { Font } from "astro:assets";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { RSSFeeds } from "@lib/rss";
import { $path } from "astro-typesafe-routes/path";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width">
    <meta name="generator" content={Astro.generator}>

    <!-- Astro fonts -->
    <Font cssVariable="--font-primary" />
    <Font cssVariable="--font-ui" />
    <Font cssVariable="--font-code" />

    <!-- astrojs/sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml">

    <!-- RSS autodiscovery. See
    https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery
    for more information -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={RSSFeeds.all.title}
      href={$path({ to: "/feeds/[feed].xml", params: { feed: "all" } })}
    >
    <link
      rel="alternate"
      type="application/rss+xml"
      title={RSSFeeds.articles.title}
      href={$path({ to: "/feeds/[feed].xml", params: { feed: "articles" } })}
    >

    <title>{`${pageTitle} - Kristoffer Balintona`}</title>
  </head>

  <body>
    <Header />
    <div class="content">
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<style>
  body {
    --page-side-padding: var(--space-s-m);
    padding: 0 var(--page-side-padding);

    .content {
      max-width: 70ch;
      min-height: 100svh;
      margin: var(--space-xs-s) auto 0;
    }
  }
</style>

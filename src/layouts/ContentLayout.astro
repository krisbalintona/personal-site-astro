---
import DiscussComments from "@components/DiscussComments.astro";
import NotByAIBadge from "@components/NotByAIBadge.astro";
import OpenHeartReactions from "@components/OpenHeartReactions.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { renderContent, toDateTimeAttribute, toPlainTitle } from "@lib/entries";
import type { AnyCollectionEntry } from "@src/content.config";

interface Props {
  entry: AnyCollectionEntry;
  uniquePath?: string;
  notAIBadge?: boolean;
  goatCounterSettings?: Record<string, string>;
}

const {
  entry,
  uniquePath,
  notAIBadge = true,
  goatCounterSettings,
} = Astro.props;

const HTMLTitle = entry.data.title;
const plainTitle = toPlainTitle(HTMLTitle);
const pubDate = "pubDate" in entry.data ? entry.data.pubDate : null;
const lastMod = "lastMod" in entry.data ? entry.data.lastMod : null;

const dateStringFormat: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
// Publication date
const formattedPubDate = pubDate && toDateTimeAttribute(pubDate);
const visiblePubDate = pubDate?.toLocaleDateString("en-US", dateStringFormat);
// Last modification
let formattedLastMod;
let visibleLastMod;
if (lastMod) {
  formattedLastMod = toDateTimeAttribute(lastMod);
  visibleLastMod = lastMod.toLocaleDateString("en-US", dateStringFormat);
}

const { Content } = await renderContent(entry);
---

<BaseLayout
  pageTitle={plainTitle}
  displayTitle={false}
  pageDescription={entry.data.description}
  goatCounterSettings={goatCounterSettings}
>
  <article>
    <header class="content-header">
      <slot name="header-meta">
        <div class="content-meta">
          {
            lastMod ? (
              <>
                <time datetime={formattedPubDate}>{visiblePubDate}</time>
                <span class="sr-only">,</span>
                <span class="last-mod">
                  last updated{" "}
                  <time datetime={formattedLastMod}>{visibleLastMod}</time>
                </span>
              </>
            ) : (
              <time datetime={formattedPubDate}>{visiblePubDate}</time>
            )
          }
        </div>
      </slot>

      {
        "subtitle" in entry.data && entry.data.subtitle ? (
          <hgroup class="content-title">
            <h1 set:html={HTMLTitle} />
            <p>{entry.data.subtitle}</p>
          </hgroup>
        ) : (
          <h1 class="content-title" set:html={HTMLTitle} />
        )
      }
    </header>

    {
      Content && (
        <div class="content-body">
          <Content />
        </div>
      )
    }

    <footer class="content-footer">
      <slot name="footer" />

      {uniquePath && <OpenHeartReactions path={uniquePath} />}
      {
        notAIBadge && (
          <div>
            <NotByAIBadge />
          </div>
        )
      }

      <DiscussComments path={uniquePath} />
    </footer>
  </article>
</BaseLayout>

<style>
  .content-header {
    margin-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-border);
    font-family: var(--font-ui);

    .content-meta {
      font-size: var(--font-step--1);
      margin: var(--space-3xs) 0;

      .last-mod {
        font-size: small;
        color: var(--color-text-muted);
      }
    }

    .content-title {
      /* With and without subtitle */
      margin: 0 0 var(--space-s) 0;

      /* Only: with subtitle */
      h1 {
        margin-top: 0;
        margin-bottom: var(--space-3xs);
      }

      p {
        margin-top: 0;
        margin-bottom: var(--space-s);
        font-style: italic;
      }
    }
  }

  .content-footer {
    margin-top: var(--space-xs);
    border-top: 2px solid var(--color-border);

    .open-heart-reactions {
      justify-content: center;
      margin: var(--space-m) 0 var(--space-l) 0;
      font-size: var(--font-step--2);
    }

    .not-ai-badge {
      display: flex;
      justify-content: center;
      margin-top: var(--space-l);
      font-size: var(--font-step-4);
    }

    #discuss-comments {
      margin-top: var(--space-l);
    }
  }
</style>

<style is:global lang="scss">
  @use "mixins";

  /* "Breakout" effect for code blocks, standalone images, and figures */
  @layer defaults {
    :where(.content-body) {
      .expressive-code {
        @include mixins.breakout(var(--space-xs-s));
      }

      figure,
      img {
        @include mixins.breakout(var(--space-s-m));
      }

      figure img {
        margin: auto;
      }
    }
  }
</style>

{/* Zoomable images */}
<script>
  const selector = ".content-body img";
  if (document.querySelector(selector)) {
    const { default: mediumZoom } = await import("medium-zoom");
    mediumZoom(selector, {
      background: "color-mix(in srgb, var(--color-bg) 80%, transparent)",
    });
  }
</script>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { renderContent } from "@lib/entries";
import type { AnyCollectionEntry } from "@src/content.config";
import { Icon } from "astro-icon/components";

interface Props {
  breadcrumbs: BreadcrumbComponent[];
  rssHref?: string;
  breadcrumbsDescription?: string;
  displayTitle?: string;
  pageTitle: string;
  preambleEntry?: AnyCollectionEntry;
}

const {
  displayTitle,
  pageTitle,
  breadcrumbs,
  breadcrumbsDescription,
  rssHref,
  preambleEntry,
} = Astro.props;

const { Content: PreambleContent } = await renderContent(preambleEntry);
---

<BaseLayout displayTitle={displayTitle} pageTitle={pageTitle}>
  <header>
    <Breadcrumb breadcrumbs={breadcrumbs}>
      {
        rssHref && (
          <Fragment slot="component-post">
            <a href={rssHref}>
              <Icon name="ph:rss" aria-hidden="true" />
            </a>
          </Fragment>
        )
      }
      {
        breadcrumbsDescription && (
          <Fragment slot="description">{breadcrumbsDescription}</Fragment>
        )
      }
    </Breadcrumb>
    {
      PreambleContent && (
        <div class="taxonomy-preamble">
          <PreambleContent />
        </div>
      )
    }
  </header>
  <slot />
</BaseLayout>

<style>
  .taxonomy-preamble {
    border-bottom: 1px solid var(--color-border);
  }

  :global(section + section) {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>

---
import { render } from "astro:content";
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isPublished } from "@lib/entries";
import type { AnyCollectionEntry } from "@src/content.config";

interface Props {
  breadcrumbs: BreadcrumbComponent[];
  breadcrumbsDescription?: string;
  displayTitle?: string;
  pageTitle: string;
  preambleEntry?: AnyCollectionEntry;
}

const {
  displayTitle,
  pageTitle,
  breadcrumbs,
  breadcrumbsDescription,
  preambleEntry,
} = Astro.props;

const { Content: PreambleContent } = preambleEntry
  ? await render(preambleEntry)
  : { Content: undefined };
---

<BaseLayout displayTitle={displayTitle} pageTitle={pageTitle}>
  <header>
    <Breadcrumb
      breadcrumbs={breadcrumbs}
      description={breadcrumbsDescription}
    />
    {preambleEntry && isPublished(preambleEntry)
      && PreambleContent && <div class="taxonomy-preamble"><PreambleContent /></div>}
  </header>
  <slot />
</BaseLayout>

<style>
  .taxonomy-preamble {
    border-bottom: 1px solid var(--color-border);
  }

  :global(section + section) {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>

---
import type { BreadcrumbComponent } from "@components/Breadcrumb.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  breadcrumbs: BreadcrumbComponent[];
  breadcrumbsDescription?: string;
  displayTitle?: string;
  pageTitle: string;
  preamble?: AstroComponentFactory;
}

const {
  displayTitle,
  pageTitle,
  breadcrumbs,
  breadcrumbsDescription,
  preamble: Preamble,
} = Astro.props;
---

<BaseLayout displayTitle={displayTitle} pageTitle={pageTitle}>
  <Breadcrumb breadcrumbs={breadcrumbs} description={breadcrumbsDescription} />
  {Preamble && <Preamble />}
  <slot />
</BaseLayout>

<style>
  :global(section + section) {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>

---
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import ExpressionTaxonomyRow from "@components/ExpressionTaxonomyRow.astro";
import NotByAIBadge from "@components/NotByAIBadge.astro";
import OpenHeartReactions from "@components/OpenHeartReactions.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getContentEntries,
  getEntryUrl,
  renderContent,
  toDateTimeAttribute,
} from "@lib/entries";
import {
  type ExpressionEntry,
  getExpressionPermalink,
  getExpressionStableId,
} from "@lib/expressions";
import { Icon } from "astro-icon/components";
import { $path } from "astro-typesafe-routes/path";

interface Props {
  expression: ExpressionEntry;
}

const { expression } = Astro.props;

const pubDate = expression.data.pubDate;
const lastMod = expression.data.lastMod;
const title = expression.data.title;

const breadcrumbs: BreadcrumbComponent[] = [
  {
    label: expression.collection,
    href: $path({ to: `/${expression.collection}` }),
  },
];

const dateStringFormat: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
// Publication date
const formattedPubDate = toDateTimeAttribute(pubDate);
const visiblePubDate = pubDate.toLocaleDateString("en-US", dateStringFormat);
// Last modification
let formattedLastMod;
let visibleLastMod;
if (lastMod) {
  formattedLastMod = toDateTimeAttribute(lastMod);
  visibleLastMod = lastMod.toLocaleDateString("en-US", dateStringFormat);
}

const tags = expression.data.tags;
const threads = expression.data.threads;
const { Content } = await renderContent(expression);
---

<BaseLayout
  pageTitle={title}
  displayTitle={false}
  pageDescription={expression.data.description}
>
  {
    /* Use `data-goatcounter-settings` to set the path counted by
    GoatCounter. See https://krisbalintona.goatcounter.com/help/path
    for more information */
  }
  <Fragment slot="script-goat-counter"
    ><script
      is:inline
      data-goatcounter="https://krisbalintona.goatcounter.com/count"
      data-goatcounter-settings={JSON.stringify({
        path: $path({
          to: "/posts/[stableId]",
          params: { stableId: getExpressionStableId(expression) },
        }),
      })}
      async
      src="//gc.zgo.at/count.js"></script></Fragment
  >
  <article>
    <header class="expression-header">
      <Breadcrumb breadcrumbs={breadcrumbs} />

      <div class="expression-info-container">
        <div class="expression-info-meta">
          {
            lastMod ? (
              <>
                <time datetime={formattedPubDate}>{visiblePubDate}</time>
                <span class="sr-only">,</span>
                <span class="last-mod">
                  last updated{" "}
                  <time datetime={formattedLastMod}>{visibleLastMod}</time>
                </span>
              </>
            ) : (
              <time datetime={formattedPubDate}>{visiblePubDate}</time>
            )
          }
          <button
            id="copy-permalink"
            aria-label="Copy permalink"
            data-permalink={getExpressionPermalink(expression)}
          >
            <Icon name="ph:link" aria-hidden="true" focusable="false" />
            <span class="copy-tooltip">Copied!</span>
          </button>
        </div>
        {
          expression.data.subtitle ? (
            <hgroup class="expression-title">
              <h1>{title}</h1>
              <p>{expression.data.subtitle}</p>
            </hgroup>
          ) : (
            <h1 class="expression-title">{title}</h1>
          )
        }
      </div>
    </header>

    {
      Content && (
        <div class="expression-content">
          <Content />
        </div>
      )
    }

    <footer class="expression-footer">
      <dl class="expression-taxonomy">
        {
          tags && (
            <ExpressionTaxonomyRow
              label="tagged"
              items={(await getContentEntries(tags)).map((tag) => ({
                href: getEntryUrl(tag),
                title: tag.data.title,
              }))}
            />
          )
        }
        {
          threads && (
            <ExpressionTaxonomyRow
              label="in threads"
              items={(await getContentEntries(threads)).map((thread) => ({
                href: getEntryUrl(thread),
                title: thread.data.title,
              }))}
            />
          )
        }
      </dl>

      <OpenHeartReactions expression={expression} />

      <div class="not-ai-badge">
        <NotByAIBadge />
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .expression-header {
    margin-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-border);

    .expression-info-container {
      font-family: var(--font-ui);

      .expression-info-meta {
        font-size: var(--font-step--1);
        margin: var(--space-3xs) 0;

        .last-mod {
          font-size: small;
          color: var(--color-text-muted);
        }

        button#copy-permalink {
          display: inline-flex;
          align-items: center;
          padding: 0;
          cursor: pointer;
          background: none;
          border: none;
          font-size: 0.9em;
          position: relative;

          &:hover [data-icon] {
            color: var(--color-accent);
          }

          .copy-tooltip {
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            font-size: var(--font-step--2);
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease;
          }

          &.copied .copy-tooltip {
            opacity: 1;
          }
        }
      }

      .expression-title {
        /* With and without subtitle */
        margin: 0 0 var(--space-s) 0;

        /* Only: with subtitle */
        h1 {
          margin-top: 0;
          margin-bottom: var(--space-3xs);
        }

        p {
          margin-top: 0;
          margin-bottom: var(--space-s);
        }
      }
    }
  }

  .expression-content {
    margin-top: var(--space-l);
  }

  .expression-footer {
    margin-top: var(--space-xs-s);
    border-top: 2px solid var(--color-border);

    .expression-taxonomy {
      margin: 0.5rem 0 var(--space-m) 0;
      padding: 0;
    }

    .open-heart-reactions {
      display: flex;
      justify-content: center;
      margin-bottom: var(--space-l);
      font-size: var(--font-step--2);
    }

    .not-ai-badge {
      display: flex;
      justify-content: center;
      font-size: var(--font-step-4);
    }
  }
</style>

<style is:global lang="scss">
  @use "mixins";

  /* "Breakout" effect for code blocks, standalone images, and figures */
  @layer defaults {
    :where(.expression-content) {
      .expressive-code {
        @include mixins.breakout(var(--space-xs-s));
      }

      figure,
      img {
        @include mixins.breakout(var(--space-s-m));
      }

      figure img {
        margin: auto;
      }
    }
  }
</style>

<script>
  const btn = document.getElementById("copy-permalink");
  btn?.addEventListener("click", () => {
    const permalink = btn.getAttribute("data-permalink");
    if (permalink) {
      // Copy to clipboard
      navigator.clipboard.writeText(
        new URL(permalink, window.location.origin).href,
      );
      // Show brief tooltip
      btn.classList.add("copied");
      const originalAriaLabel = btn.getAttribute("aria-label");
      btn.setAttribute("aria-label", "Permalink copied!");
      setTimeout(() => {
        btn.classList.remove("copied");
        // Restore aria-label to ensure it is reset when the user
        // presses the button in quick succession
        btn.setAttribute("aria-label", originalAriaLabel ?? "Copy permalink");
      }, 2000);
    }
  });
</script>

{/* Zoomable images */}
<script>
  const selector = ".expression-content img";
  if (document.querySelector(selector)) {
    const { default: mediumZoom } = await import("medium-zoom");
    mediumZoom(selector, {
      background: "color-mix(in srgb, var(--color-bg) 80%, transparent)",
    });
  }
</script>

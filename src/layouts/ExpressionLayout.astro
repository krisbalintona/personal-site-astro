---
import { getEntries, render } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { toDateTimeAttribute } from "@lib/entries";
import type { ExpressionEntry } from "@lib/expressions";
import Link from "astro-typesafe-routes/link";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

interface Props {
  expression: ExpressionEntry;
}

const { expression } = Astro.props;

const pubDate = expression.data.pubDate;
const title = expression.data.title;

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "prose", href: $path({ to: "/prose" }) },
  {
    label: expression.collection,
    href: $path({ to: `/${expression.collection}` }),
  },
];

const formattedDateTime = toDateTimeAttribute(pubDate);
const formattedVisibleDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const tags = expression.data.tags;
const threads = expression.data.threads;
const { Content } = await render(expression);
---

<BaseLayout pageTitle={title}>
  <article>
    <header class="expression-header">
      <Breadcrumb breadcrumbs={breadcrumbs} />

      <div class="expression-info-container">
        <time class="expression-date" datetime={formattedDateTime}
          >{formattedVisibleDate}</time
        >

        <h1 class="expression-title">{title}</h1>
      </div>
    </header>

    <div class="expression-content"><Content /></div>

    <footer class="expression-footer">
      <dl class="expression-taxonomy">
        {tags && (
          <div class="expression-taxonomy-container">
            <dt>tagged</dt>
            <dd>{await Promise.all((await getEntries(tags)).map((tag) => {
              return (
                <span><Link
                  params={{ tag: slugify(tag.data.title) }}
                  to="/tags/[tag]"
                >{tag.data.title}</Link></span>
              );
            }))}</dd>
          </div>
        )}
        {threads && (
          <div class="expression-taxonomy-container">
            <dt>in threads</dt>
            <dd>{await Promise.all((await getEntries(threads)).map((thread) => {
              return (
                <span><Link
                  params={{ thread: slugify(thread.data.title) }}
                  to="/threads/[thread]"
                >{thread.data.title}</Link></span>
              );
            }))}</dd>
          </div>
        )}
      </dl>
    </footer>
  </article>
</BaseLayout>

<style>
  .expression-header {
    margin-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-border);

    .expression-info-container {
      .expression-date {
        display: block;
        margin: var(--space-3xs-2xs) 0;
        font-family: var(--font-ui);
        font-size: var(--font-step--1);
      }

      .expression-title {
        margin: 0 0 var(--space-s) 0;
      }
    }
  }

  .expression-content {
    margin-top: var(--space-l);
  }

  .expression-footer {
    margin-top: var(--space-xs-s);
    border-top: 2px solid var(--color-border);

    .expression-taxonomy-container {
      display: block;
      font-size: var(--font-step--1);

      dt,
      dd {
        display: inline;
        margin: 0;
      }

      /* Space after colon is added via margin rather than a content
         string, as trailing spaces in pseudo-element content can be
         collapsed inconsistently across browsers */
      dt::after {
        margin-right: 0.25em;
        content: ":";
      }

      dt {
        font-weight: bold;
      }

      span + span::before {
        content: ", ";
      }

      a {
        --link-underline-color: transparent;
        font-style: italic;
        color: var(--color-text-muted);
        transition: color 0.15s;

        &:hover {
          color: var(--color-text);
        }
      }
    }
  }
</style>

<style is:global lang="scss">
  @use "mixins";

  /* "Breakout" effect for code blocks, standalone images, and figures */
  @layer defaults {
    :where(.expression-content) {
      .expressive-code {
        @include mixins.breakout(var(--space-xs-s));
      }

      figure,
      img {
        @include mixins.breakout(var(--space-s-m));
      }

      figure img {
        margin: auto;
      }
    }
  }
</style>

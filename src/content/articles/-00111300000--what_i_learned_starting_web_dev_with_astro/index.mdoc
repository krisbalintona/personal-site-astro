}

bibtex: Bibtex and Natbib Processor {
  latex: LaTeX
  pdf: PDF {
    shape: oval
  }
  latex -> pdf: Compile with citations as LaTeX commands {
    style.stroke-dash: 4
  }
}

org-export -> csl.outputs: {style.stroke-width: 4}
org-export -> bibtex.latex: {style.stroke-width: 4}
org-export -> csl.latex: {style.stroke-width: 4}
```


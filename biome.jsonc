{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off"
      },
      "correctness": {
        // Biome does not have the ability to read path aliases in
        // tsconfig.json, so it will report false positives.  See
        // https://github.com/biomejs/biome/issues/3554
        "noUndeclaredDependencies": "off",
        // Biome does not recognize "virtual modules," modules that
        // Astro generates at run/build time and exposes via Vite
        "noUnresolvedImports": "off"
      }
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/astro",
    "ultracite/biome/type-aware"
  ]
}

---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Breadcrumb, {
  type BreadcrumbComponent,
} from "@components/Breadcrumb.astro";
import Heading from "@components/markup/Heading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntryUrl } from "@lib/entries";
import type { ExpressionEntry } from "@lib/expressions";
import ExpressionListingCompact from "@src/components/ExpressionListingCompact.astro";
import { $path } from "astro-typesafe-routes/path";
import slugify from "slugify";

function inThisThread(thread: CollectionEntry<"threads">) {
  return (expression: ExpressionEntry): boolean =>
    expression.data.threads?.some((s) => s.id === thread.id) ?? false;
}

const breadcrumbs: BreadcrumbComponent[] = [
  { label: "explore", href: $path({ to: "/explore" }) },
  { label: "Threads", styleNormal: true },
];
---

<BaseLayout pageTitle="Threads" displayTitle="All threads">
  <Breadcrumb breadcrumbs={breadcrumbs} />
  {
    (await getCollection("threads")).map((thread) => {
      const headingId = slugify(thread.data.title, {
        lower: true,
        strict: true,
      });
      return (
        <section aria-labelledby={headingId}>
          <Heading id={headingId} level="3" selfLink={true}>
            {thread.data.title}
          </Heading>

          <ExpressionListingCompact
            browseAllLink={getEntryUrl(thread)}
            collections={["articles", "notes"]}
            descending={false}
            extraFilter={inThisThread(thread)}
            limit={5}
          />
        </section>
      );
    })
  }
</BaseLayout>

<style>
  section + section {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>
